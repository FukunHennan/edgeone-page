{
  "name": "edgeone-page",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:production",
  "outputDirectory": "astro-dist",
  "nodeVersion": "22.21.1",
  "redirects": [
    {
      "source": "/zh",
      "destination": "/zh-CN/",
      "statusCode": 301
    },
    {
      "source": "/zh/*",
      "destination": "/zh-CN/:splat",
      "statusCode": 301
    },
    {
      "source": "/cn",
      "destination": "/zh-CN/",
      "statusCode": 301
    },
    {
      "source": "/cn/*",
      "destination": "/zh-CN/:splat",
      "statusCode": 301
    },
    {
      "source": "/en-US",
      "destination": "/en/",
      "statusCode": 301
    },
    {
      "source": "/en-US/*",
      "destination": "/en/:splat",
      "statusCode": 301
    },
    {
      "source": "/zh-CN/page/*",
      "destination": "/zh-CN/archives/",
      "statusCode": 301
    },
    {
      "source": "/en/page/*",
      "destination": "/en/archives/",
      "statusCode": 301
    },
    {
      "source": "/zh-CN/archives/page/*",
      "destination": "/zh-CN/archives/",
      "statusCode": 301
    },
    {
      "source": "/en/archives/page/*",
      "destination": "/en/archives/",
      "statusCode": 301
    },
    {
      "source": "/zh-CN/archives/2025/page/*",
      "destination": "/zh-CN/archives/2025/",
      "statusCode": 301
    },
    {
      "source": "/en/archives/2025/page/*",
      "destination": "/en/archives/2025/",
      "statusCode": 301
    },
    {
      "source": "/zh-CN/archives/2026/page/*",
      "destination": "/zh-CN/archives/2026/",
      "statusCode": 301
    },
    {
      "source": "/en/archives/2026/page/*",
      "destination": "/en/archives/2026/",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/theme/fontawesome/subset.min.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/theme/webfonts/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/theme/js/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/scene-sizes/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/scenes/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/covers/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/icons/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/zh-CN/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/en/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
