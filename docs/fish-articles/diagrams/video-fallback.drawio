<mxfile host="app.diagrams.net"><diagram id="video-fallback" name="Video transport path selection"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="420" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n0" value="1. Direct WebRTC&lt;br&gt;Host candidates only&lt;br&gt;ICE + first and fresh frames&lt;br&gt;Stay while video is usable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf4ee;strokeColor=#58775e;fontColor=#263630;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="132" width="310" height="166" as="geometry"/></mxCell><mxCell id="n1" value="2. TURN relay&lt;br&gt;Relay candidates only&lt;br&gt;ICE + first and fresh frames&lt;br&gt;Stay while video is usable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f9;strokeColor=#537391;fontColor=#263630;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="425" y="132" width="310" height="166" as="geometry"/></mxCell><mxCell id="n2" value="3. JPEG snapshots&lt;br&gt;Same-origin WebSocket via Go&lt;br&gt;Send the newest frame only&lt;br&gt;Reconnect snapshots on failure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f5f3;strokeColor=#3e7771;fontColor=#263630;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="820" y="132" width="310" height="166" as="geometry"/></mxCell><mxCell id="e0" value="failed / stale" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#65756f;strokeWidth=2;endArrow=blockThin;fontColor=#53645e;fontSize=12;" edge="1" parent="1" source="n0" target="n1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="failed / no TURN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#65756f;strokeWidth=2;endArrow=blockThin;fontColor=#53645e;fontSize=12;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
