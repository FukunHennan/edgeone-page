<mxfile host="app.diagrams.net"><diagram id="design-checks" name="三类校验，各有边界"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="345" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n0" value="设备身份&lt;br&gt;注册时 HMAC 挑战应答&lt;br&gt;共享部署密钥&lt;br&gt;nonce + 规范化 MAC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf4ee;strokeColor=#58775e;fontColor=#263630;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="102" width="260" height="172" as="geometry"/></mxCell><mxCell id="n1" value="控制归属&lt;br&gt;设备 + 账号 + 客户端租约&lt;br&gt;拒绝过期和越权操作&lt;br&gt;停止时清除旧运动" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f9;strokeColor=#537391;fontColor=#263630;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="320" y="102" width="260" height="172" as="geometry"/></mxCell><mxCell id="n2" value="升级结果&lt;br&gt;SHA-256 镜像校验&lt;br&gt;重启并重新上线&lt;br&gt;新 bootId + 版本 + 构建" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e8;strokeColor=#aa7447;fontColor=#263630;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="610" y="102" width="260" height="172" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
