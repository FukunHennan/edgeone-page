<mxfile host="app.diagrams.net"><diagram id="design-checks" name="Three different checks"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="345" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n0" value="Device identity&lt;br&gt;HMAC challenge at registration&lt;br&gt;Shared deployment key&lt;br&gt;Nonce + normalized MAC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf4ee;strokeColor=#58775e;fontColor=#263630;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="102" width="260" height="172" as="geometry"/></mxCell><mxCell id="n1" value="Control ownership&lt;br&gt;Device + account + client lease&lt;br&gt;Reject stale or other-owner input&lt;br&gt;Clear queued motion on stop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f9;strokeColor=#537391;fontColor=#263630;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="320" y="102" width="260" height="172" as="geometry"/></mxCell><mxCell id="n2" value="Firmware result&lt;br&gt;SHA-256 image check&lt;br&gt;Reboot and reconnect&lt;br&gt;New bootId + version + build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e8;strokeColor=#aa7447;fontColor=#263630;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="610" y="102" width="260" height="172" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
