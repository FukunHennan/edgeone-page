<mxfile host="app.diagrams.net"><diagram id="frontend-backend-flow" name="前后端请求与设备、视频流程"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="475" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n0" value="浏览器前端&lt;br&gt;赛事页 + 管理台&lt;br&gt;操作输入与视频展示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf4ee;strokeColor=#58775e;fontColor=#263630;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="240" height="126" as="geometry"/></mxCell><mxCell id="n1" value="Go 服务&lt;br&gt;账号 + 赛事状态&lt;br&gt;控制准入 + API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f9;strokeColor=#537391;fontColor=#263630;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="380" y="120" width="240" height="126" as="geometry"/></mxCell><mxCell id="n2" value="ESP32 固件&lt;br&gt;运动 + 状态回传&lt;br&gt;本地停止检查" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e8;strokeColor=#aa7447;fontColor=#263630;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="730" y="120" width="240" height="126" as="geometry"/></mxCell><mxCell id="n3" value="Python 视频&lt;br&gt;相机 + WebRTC + 录像" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f5f3;strokeColor=#3e7771;fontColor=#263630;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="380" y="320" width="240" height="102" as="geometry"/></mxCell><mxCell id="e0" value="HTTP / WebSocket" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#65756f;strokeWidth=2;endArrow=blockThin;fontColor=#53645e;fontSize=12;" edge="1" parent="1" source="n0" target="n1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="设备 W