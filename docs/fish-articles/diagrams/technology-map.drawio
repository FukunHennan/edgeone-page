<mxfile host="app.diagrams.net"><diagram id="technology-map" name="Technology and responsibilities"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="550" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n0" value="Browser interfaces&lt;br&gt;HTML / CSS / JavaScript + React / Vite&lt;br&gt;Player and referee workflows; device administration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf4ee;strokeColor=#58775e;fontColor=#263630;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="86" width="770" height="88" as="geometry"/></mxCell><mxCell id="n1" value="Control hub&lt;br&gt;Go + Gorilla WebSocket&lt;br&gt;Identity, leases, commands, match state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f9;strokeColor=#537391;fontColor=#263630;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="188" width="770" height="88" as="geometry"/></mxCell><mxCell id="n2" value="Device firmware&lt;br&gt;ESP32-C3 + Arduino / PlatformIO&lt;br&gt;Servo motion, telemetry, local stop checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e8;strokeColor=#aa7447;fontColor=#263630;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="770" height="88" as="geometry"/></mxCell><mxCell id="n3" value="Camera and video&lt;br&gt;Python + OpenCV / Flask / aiortc / PyAV&lt;br&gt;Capture, framing, streaming, recording" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f5f3;strokeColor=#3e7771;fontColor=#263630;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="392" width="770" height="88" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
