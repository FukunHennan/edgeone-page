{
  "name": "edgeone-page",
  "version": "0.0.0",
  "private": true,
  "description": "A bilingual Astro site deployed on Tencent EdgeOne Pages.",
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev:astro": "astro dev --host 127.0.0.1",
    "check:astro": "node tools/validate-bilingual.js && astro check",
    "build:astro": "npm run check:astro && astro build && node tools/postprocess-astro.cjs && node tools/audit-astro.cjs",
    "preview:astro": "astro preview --host 127.0.0.1",
    "clean": "node -e \"for(const path of ['astro-dist','.astro'])require('fs').rmSync(path,{recursive:true,force:true})\"",
    "dev": "npm run dev:astro",
    "build": "npm run build:production",
    "build:production": "node tools/check-runtime.js && npm run build:astro",
    "audit:production": "node tools/audit-astro.cjs",
    "check": "npm run build:production && npm run check:articles",
    "check:content": "node tools/check-runtime.js && node tools/validate-bilingual.js",
    "check:articles": "node tools/check-articles.js",
    "check:runtime": "node tools/check-runtime.js",
    "new:post": "node tools/new-bilingual-post.js",
    "preview:production": "node tools/check-runtime.js && npm run build:production && npm run preview:astro",
    "server": "npm run dev",
    "subset:icons": "python3 tools/subset-icons.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FukunHennan/edgeone-page.git"
  },
  "bugs": {
    "url": "https://github.com/FukunHennan/edgeone-page/issues"
  },
  "homepage": "https://github.com/FukunHennan/edgeone-page#readme",
  "engines": {
    "node": ">=22.21.1 <23",
    "npm": ">=10.9.0 <11"
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "hexo-util": "^4.0.0",
    "js-yaml": "^4.1.1",
    "nib": "^1.2.0",
    "stylus": "^0.62.0"
  },
  "overrides": {
    "strip-ansi": "6.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.20.5",
    "astro": "7.3.8",
    "typescript": "5.9.3"
  }
}
