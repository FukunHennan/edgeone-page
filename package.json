{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "description": "A Simplified Chinese and English Hexo site optimized for Tencent EdgeOne Pages.",
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev:astro": "astro dev --host 127.0.0.1",
    "check:astro": "node tools/validate-bilingual.js && astro check",
    "build:astro": "npm run check:astro && astro build && node tools/audit-astro.cjs",
    "preview:astro": "astro preview --host 127.0.0.1",
    "clean": "node -e \"require('fs').rmSync('public',{recursive:true,force:true});require('fs').rmSync('db.json',{force:true})\"",
    "dev": "node tools/dev-preview.js",
    "dev:en": "node tools/dev-preview.js --en",
    "build": "npm run build:production",
    "build:production": "node tools/check-runtime.js && node tools/build-bilingual.js",
    "audit:production": "node tools/audit-production.js",
    "check": "node tools/check-runtime.js && node tools/validate-bilingual.js && npm run build:production && npm run audit:production",
    "check:content": "node tools/check-runtime.js && node tools/validate-bilingual.js",
    "check:articles": "node tools/check-articles.js",
    "check:runtime": "node tools/check-runtime.js",
    "new:post": "node tools/new-bilingual-post.js",
    "preview:production": "node tools/check-runtime.js && npm run build:production && node tools/preview-public.js",
    "server": "npm run dev",
    "server:zh-CN": "hexo server --config _config.yml,_config.zh-CN.yml",
    "server:en": "hexo server --config _config.yml,_config.en.yml",
    "deploy": "hexo deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FukunHennan/edgeone-page.git"
  },
  "bugs": {
    "url": "https://github.com/FukunHennan/edgeone-page/issues"
  },
  "homepage": "https://github.com/FukunHennan/edgeone-page#readme",
  "engines": {
    "node": ">=22.11.0 <23",
    "npm": ">=10.9.0 <11"
  },
  "hexo": {
    "version": "8.1.1"
  },
  "dependencies": {
    "hexo": "^8.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-feed": "^4.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-searchdb": "^1.5.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-theme-landscape": "^1.0.0",
    "hexo-wordcount": "^6.0.1",
    "html2canvas-pro": "^2.4.4",
    "js-yaml": "^4.1.1",
    "jspdf": "^4.2.1"
  },
  "overrides": {
    "strip-ansi": "6.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.20.5",
    "astro": "7.3.8",
    "typescript": "5.9.3"
  }
}
