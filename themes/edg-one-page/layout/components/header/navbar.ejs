<%
const currentLanguage = Array.isArray(config.language) ? config.language[0] : config.language;
const isZh = currentLanguage === 'zh-CN';
const navItems = [
  { id: 'home', zh: '首页', en: 'Home', path: '/', icon: 'fa-regular fa-house' },
  { id: 'projects', zh: '项目', en: 'Projects', path: '/projects/', icon: 'fa-regular fa-folder-open' },
  { id: 'experience', zh: '经历', en: 'Experience', path: '/experience/', icon: 'fa-regular fa-id-card' },
  { id: 'resume', zh: '简历', en: 'Resume', path: '/resume/', icon: 'fa-regular fa-file-lines' },
  { id: 'about', zh: '关于', en: 'About', path: '/about/', icon: 'fa-regular fa-user' }
];
const targetLanguage = isZh ? 'en' : 'zh-CN';
const languageHref = alternatePath || `/${targetLanguage}/`;
const languageLabel = isZh ? 'Switch to English' : '切换到简体中文';
function itemActive(item) {
  if (item.id === 'home') return is_home();
  return is_current(item.path);
}
%>
<header class="navbar-container personal-hub-navbar px-4 md:px-8">
  <div class="navbar-content transition-navbar">
    <div class="left hub-brand-wrap">
      <a class="hub-brand" href="<%= config.root %>" aria-label="Personal Hub">
        <span class="hub-brand-mark"><img src="<%= url_for('/images/稻田鼠.jpg') %>" alt="稻田鼠"></span>
        <span class="hub-brand-copy">
        <strong>稻田鼠</strong>
          <small>BUILD · LEARN · CREATE</small>
        </span>
      </a>
    </div>

    <div class="right">
      <div class="desktop">
        <ul class="navbar-list hub-navbar-list">
          <% navItems.forEach(function(item) { %>
            <li class="navbar-item hub-nav-item">
              <a class="<%= itemActive(item) ? 'active' : '' %>" href="<%- url_for(item.path) %>">
                <span><%= isZh ? item.zh : item.en %></span>
              </a>
            </li>
          <% }); %>
        </ul>
      </div>

      <div class="hub-nav-actions">
        <a class="hub-language-link" href="<%= languageHref %>" lang="<%= targetLanguage %>" data-alternate-href="<%= languageHref %>" aria-label="<%= languageLabel %>" title="<%= languageLabel %>"><%= isZh ? 'EN' : '中' %></a>
        <a class="hub-github-link" href="https://github.com/FukunHennan/edgeone-page" target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub">
          <i class="fa-brands fa-github" aria-hidden="true"></i>
        </a>
      </div>

      <div class="mobile hub-mobile-actions">
        <a class="hub-language-link hub-language-link-mobile" href="<%= languageHref %>" lang="<%= targetLanguage %>" data-alternate-href="<%= languageHref %>" aria-label="<%= languageLabel %>" title="<%= languageLabel %>"><%= isZh ? 'EN' : '中' %></a>
        <button class="icon-item navbar-bar" type="button" aria-controls="mobile-site-navigation" aria-expanded="false" aria-label="<%= isZh ? '菜单' : 'Menu' %>"><span class="navbar-bar-middle"></span></button>
      </div>
    </div>
  </div>

  <div id="mobile-site-navigation" class="navbar-drawer h-dvh w-full absolute top-0 left-0 flex flex-col justify-between">
    <div class="hub-drawer-head">
      <span class="hub-brand-mark"><img src="<%= url_for('/images/稻田鼠.jpg') %>" alt="稻田鼠"></span>
      <span><strong>稻田鼠</strong><small>BUILD · LEARN · CREATE</small></span>
    </div>
    <ul class="drawer-navbar-list hub-drawer-list flex flex-col px-5 justify-center items-start">
      <% navItems.forEach(function(item) { %>
        <li class="drawer-navbar-item w-full">
          <a class="<%= itemActive(item) ? 'active' : '' %>" href="<%- url_for(item.path) %>">
            <span><%= isZh ? item.zh : item.en %></span>
            <i class="<%= item.icon %> fa-fw"></i>
          </a>
        </li>
      <% }); %>
    </ul>
    <div class="hub-drawer-bottom">
      <a href="https://github.com/FukunHennan/edgeone-page" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    </div>
  </div>
  <div class="window-mask"></div>
</header>
