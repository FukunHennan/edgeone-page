<% const zh = config.language === 'zh-CN'; const latest = page.posts.slice(0, 2); %>
<section class="hub-shell hub-dashboard">
  <div class="hub-hero hub-hero-v2">
    <div class="hub-aurora"></div><div class="hub-orb hub-orb-a"></div><div class="hub-orb hub-orb-b"></div>
    <div class="hub-hero-copy">
      <div class="hub-kicker">HELLO, I'M</div>
      <h1><span>Fukun</span> Hennan</h1>
      <p class="hub-role"><%= zh ? '工程 · 机器人 · 嵌入式 · 计算机视觉' : 'Engineering · Robotics · Embedded · Computer Vision' %></p>
      <p class="hub-intro"><%= zh ? '在这里，我记录学习、构建项目、分享经验，并打造一个属于自己的数字工作台。' : 'A place where I learn, build projects, share experience and grow my own digital workspace.' %></p>
      <div class="hub-actions"><a class="hub-btn hub-btn-primary" href="<%- url_for('/projects/') %>">🚀 <%= zh ? '探索我的项目' : 'Explore projects' %> <span>→</span></a><a class="hub-btn" href="<%- url_for('/archives/') %>">▣ <%= zh ? '阅读最新博客' : 'Read the blog' %></a></div>
    </div>
    <div class="hub-hero-sign">Build<br>Learn<br>Create<br><small>a Better Tomorrow.</small></div>
    <div class="hub-stats"><div><b>12+</b><span><%= zh ? '项目' : 'Projects' %></span></div><div><b>50+</b><span><%= zh ? '技术笔记' : 'Notes' %></span></div><div><b>6+</b><span><%= zh ? '实用工具' : 'Tools' %></span></div><div><b>∞</b><span><%= zh ? '持续探索' : 'Exploring' %></span></div></div>
  </div>

  <div class="hub-section-head hub-compact-head"><div><span class="hub-eyebrow">QUICK ACCESS</span><h2><%= zh ? '快速入口' : 'Quick access' %></h2><p><%= zh ? '从这里开始，探索我的数字世界。' : 'Start here and explore the workspace.' %></p></div></div>
  <div class="hub-quick-grid">
    <a class="hub-quick-card" href="<%- url_for('/archives/') %>"><div class="hub-icon">▤</div><div><h3><%= zh ? '博客' : 'Blog' %></h3><p><%= zh ? '技术分享、学习记录与思考' : 'Writing, learning and thoughts' %></p></div><b>→</b></a>
    <a class="hub-quick-card" href="<%- url_for('/notes/') %>"><div class="hub-icon">▣</div><div><h3><%= zh ? '笔记' : 'Notes' %></h3><p><%= zh ? '知识整理与技术文档' : 'Knowledge and technical docs' %></p></div><b>→</b></a>
    <a class="hub-quick-card" href="<%- url_for('/projects/') %>"><div class="hub-icon">◇</div><div><h3><%= zh ? '项目' : 'Projects' %></h3><p><%= zh ? '正在构建的项目与研究' : 'Projects and research' %></p></div><b>→</b></a>
    <a class="hub-quick-card" href="<%- url_for('/tools/') %>"><div class="hub-icon">⌕</div><div><h3><%= zh ? '工具箱' : 'Toolbox' %></h3><p><%= zh ? '实用的在线工具集合' : 'Useful online utilities' %></p></div><b>→</b></a>
    <a class="hub-quick-card" href="<%- url_for('/experience/') %>"><div class="hub-icon">◎</div><div><h3><%= zh ? '经历' : 'Experience' %></h3><p><%= zh ? '个人经历与技能' : 'Experience and skills' %></p></div><b>→</b></a>
    <a class="hub-quick-card" href="<%- url_for('/about/') %>"><div class="hub-icon">i</div><div><h3><%= zh ? '关于' : 'About' %></h3><p><%= zh ? '了解更多关于我' : 'More about me' %></p></div><b>→</b></a>
  </div>

  <div class="hub-dashboard-grid">
    <section><div class="hub-section-head hub-row-head"><div><span class="hub-eyebrow">LATEST WRITING</span><h2><%= zh ? '最新文章' : 'Latest writing' %></h2></div><a href="<%- url_for('/archives/') %>"><%= zh ? '查看更多' : 'View all' %> →</a></div><div class="hub-writing-list"><% latest.forEach((post) => { %><a href="<%- url_for(post.path) %>"><span class="hub-writing-icon">▤</span><div><h3><%= post.title %></h3><p><%= post.tags && post.tags.length ? post.tags.data.slice(0,3).map(t => '#'+t.name).join(' · ') : '#Engineering · #Notes' %></p></div><time><%= date(post.date,'YYYY-MM-DD') %></time></a><% }) %><% if (!latest.length) { %><div class="hub-empty"><%= zh ? '文章正在整理中。' : 'Writing is being organized.' %></div><% } %></div></section>
    <section><div class="hub-section-head hub-row-head"><div><span class="hub-eyebrow">FEATURED PROJECT</span><h2><%= zh ? '精选项目' : 'Featured project' %></h2></div><a href="<%- url_for('/projects/') %>"><%= zh ? '查看更多' : 'View all' %> →</a></div><a class="hub-feature-project" href="<%- url_for('/projects/') %>"><div class="hub-fish-art"><span>◁</span><i></i></div><div><span class="hub-live">● <%= zh ? '进行中' : 'ACTIVE' %></span><h3><%= zh ? '仿生鱼机器人平台' : 'Fish Robot Platform' %></h3><p><%= zh ? '基于 ESP32 的水下机器人控制平台，支持 WebSocket、OTA 和可视化控制界面。' : 'ESP32 robot platform with WebSocket, OTA and visual control UI.' %></p><div class="hub-mini-tags"><span>ESP32</span><span>WebSocket</span><span>OTA</span><span>Robot</span></div></div></a></section>
    <section><div class="hub-section-head hub-row-head"><div><span class="hub-eyebrow">TOOLS</span><h2><%= zh ? '工具推荐' : 'Tools' %></h2></div><a href="<%- url_for('/tools/') %>"><%= zh ? '查看更多' : 'View all' %> →</a></div><div class="hub-tool-list"><a href="<%- url_for('/tools/') %>"><b>{ }</b><span><strong>JSON <%= zh ? '格式化' : 'Formatter' %></strong><small><%= zh ? '格式化、压缩和验证 JSON 数据' : 'Format and validate JSON' %></small></span></a><a href="<%- url_for('/tools/') %>"><b>01</b><span><strong><%= zh ? '进制转换' : 'Base converter' %></strong><small>BIN · OCT · DEC · HEX</small></span></a><a href="<%- url_for('/tools/') %>"><b>◷</b><span><strong><%= zh ? '时间戳转换' : 'Timestamp' %></strong><small>Unix timestamp ↔ Date</small></span></a></div></section>
  </div>
</section>