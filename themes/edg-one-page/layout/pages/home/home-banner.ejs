<% const isZh = config.language === 'zh-CN'; %>
<section class="mimo-home-hero" aria-labelledby="home-hero-title">
  <div class="mimo-home-copy">
    <p class="mimo-home-kicker"><%= isZh ? '一个持续生长的个人空间' : 'A personal space in progress' %></p>
    <h1 id="home-hero-title">
      <span><%= isZh ? '你好，我是稻田鼠' : 'Hello, I’m Fukun' %></span>
      <span><%= isZh ? '在好奇心里，继续向前。' : 'Moving forward with curiosity.' %></span>
    </h1>
    <p class="mimo-home-description"><%= isZh ? '记录工程、机器人与日常灵感。把每一次探索，慢慢写成作品。' : 'Notes on engineering, robotics and everyday ideas. Turning each exploration into something real.' %></p>
    <div class="mimo-home-actions">
      <a class="mimo-home-button mimo-home-button-primary" href="<%- url_for('/projects/') %>"><%= isZh ? '探索项目' : 'Explore projects' %><span aria-hidden="true">↗</span></a>
      <a class="mimo-home-button" href="<%- url_for('/archives/') %>"><%= isZh ? '阅读博客' : 'Read the blog' %><span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <div class="mimo-home-art" aria-hidden="true">
    <div class="mimo-art-halo mimo-art-halo-one"></div>
    <div class="mimo-art-halo mimo-art-halo-two"></div>
    <div class="mimo-art-dots"></div>
    <div class="mimo-art-word">B<span>·</span>L<span>·</span>C</div>
    <div class="mimo-art-caption"><span>BUILD</span><span>LEARN</span><span>CREATE</span></div>
    <div class="mimo-art-index">01 / ∞</div>
  </div>
  <a class="mimo-scroll-cue" href="#home-content"><span><%= isZh ? '向下探索' : 'Scroll to explore' %></span><span aria-hidden="true">↓</span></a>
</section>
