<% const pageData = getPageData(page); %>
<% const rawContent = page.content || ''; %>
<% const isHubWorkspace = /class=["'][^"']*(workspace-page|hub-shell|projects-workspace|toolbox-workspace|notes-workspace)[^"']*["']/.test(rawContent); %>
<div class="page-template-container<%= isHubWorkspace ? ' hub-workspace-container' : '' %>">
	<% if (pageData) { %>
	<%- partial(pageData.partial) %>
	<% } %>

	<div class="page-template-content markdown-body<%= isHubWorkspace ? ' hub-workspace-content' : '' %>">
		<% if (!pageData && !isHubWorkspace) { %>
		<h1><%- page.title %></h1>
		<% } %>

		<%- page.content %>
	</div>

	<div class="page-template-comments">
		<% if (page.hasOwnProperty('comment') && (page.comment === true || page.comments === true) ) { %>
		<%- partial('components/comments/comment') %>
		<% } %>
	</div>
</div>

<%- partial('utils/paginator', {pageObject: page}) %>