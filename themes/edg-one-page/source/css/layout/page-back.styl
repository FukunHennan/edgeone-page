/* 站内返回控件。与 Astro 版 Shell 共用同一套样式，避免两套构建各写一份。 */
.page-back
  position fixed
  left 24px
  bottom 24px
  z-index 90
  display inline-flex
  align-items center
  gap 8px
  min-height 44px
  padding 10px 16px
  border 1px solid var(--hub-line)
  border-radius 999px
  background var(--hub-surface)
  color var(--hub-text)
  box-shadow var(--hub-shadow)
  font-size 13px
  text-decoration none
  transition border-color 0.2s ease, color 0.2s ease

  &:hover
    border-color var(--mimo-green, var(--hub-blue))
    color var(--mimo-green, var(--hub-blue))

  .page-back-icon
    font-size 15px
    line-height 1

body.navbar-drawer-show .page-back
html.archive-embed .page-back
  visibility hidden

@media (max-width 600px)
  .page-back
    left 16px
    bottom calc(16px + env(safe-area-inset-bottom))
    padding 8px 13px
    font-size 12px

@media print
  .page-back
    display none !important
