/* Shared Personal Hub workspace layer. Keep page Markdown focused on structure. */
.workspace-metrics{position:absolute;right:34px;bottom:28px;z-index:2;display:flex;gap:8px}.workspace-metrics div{min-width:88px;padding:12px 15px;border:1px solid var(--hub-line);border-radius:12px;background:var(--hub-bg);text-align:center}.workspace-metrics b{display:block;font-size:20px;color:var(--hub-text)}.workspace-metrics small{display:block;margin-top:3px;color:var(--hub-muted);font-size:7px;letter-spacing:.12em}.workspace-hero-projects{padding-right:330px}.project-workspace-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.project-workspace-grid article{min-height:245px;display:flex;flex-direction:column;padding:21px;border:1px solid var(--hub-line);border-radius:16px;background:var(--hub-surface);transition:transform .2s,border-color .2s,box-shadow .2s}.project-workspace-grid article:hover{transform:translateY(-4px);border-color:rgba(165,180,252,.34);box-shadow:0 16px 38px rgba(15,23,42,.08)}.project-workspace-grid article[hidden]{display:none}.project-card-top{display:flex;justify-content:space-between;align-items:center}.project-card-top>b{color:rgba(100,116,139,.2);font-size:26px}.project-status{font-size:8px;font-weight:850;letter-spacing:.12em}.project-status.active{color:#6366f1}.project-status.research{color:#a78bfa}.project-status.software{color:#a5b4fc}.project-status.lab{color:#f59e0b}.project-workspace-grid h3{margin:16px 0 8px;font-size:21px;letter-spacing:-.025em}.project-workspace-grid p{margin:0;color:var(--hub-muted);font-size:11px;line-height:1.7}.project-tags{display:flex;gap:5px;flex-wrap:wrap;margin-top:15px}.project-tags span{padding:4px 7px;border-radius:999px;background:rgba(100,116,139,.1);color:var(--hub-muted);font-size:8px}.project-workspace-grid footer{display:flex;gap:14px;margin-top:auto;padding-top:18px}.project-workspace-grid footer a{color:#a5b4fc;font-size:10px;font-weight:750}.projects-workspace .workspace-content{min-width:0}
@media(max-width:900px){.workspace-hero-projects{padding-right:42px;padding-bottom:105px}.workspace-metrics{left:42px;right:auto;bottom:24px}}
@media(max-width:768px){.workspace-hero-projects{padding-right:22px;padding-bottom:130px}.workspace-metrics{left:22px;right:22px;display:grid;grid-template-columns:repeat(3,1fr)}.workspace-metrics div{min-width:0}.project-workspace-grid{grid-template-columns:1fr}}
@media(max-width:480px){.workspace-metrics{grid-template-columns:repeat(3,1fr);gap:5px}.workspace-metrics div{padding:10px 5px}.project-workspace-grid article{min-height:220px}}
