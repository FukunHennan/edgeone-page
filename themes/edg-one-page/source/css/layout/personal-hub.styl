:root
  --hub-bg #f5f7fb
  --hub-surface rgba(255,255,255,.76)
  --hub-surface-solid #ffffff
  --hub-text #101828
  --hub-muted #667085
  --hub-line rgba(15,23,42,.09)
  --hub-line-strong rgba(37,99,235,.22)
  --hub-blue #2563eb
  --hub-cyan #06b6d4
  --hub-shadow 0 24px 70px rgba(15,23,42,.08)

.dark
  --hub-bg #070c16
  --hub-surface rgba(14,22,37,.78)
  --hub-surface-solid #101827
  --hub-text #f5f7fb
  --hub-muted #98a2b3
  --hub-line rgba(255,255,255,.085)
  --hub-line-strong rgba(56,189,248,.24)
  --hub-shadow 0 28px 80px rgba(0,0,0,.28)

html
  scroll-behavior smooth

body
  background var(--hub-bg)
  color var(--hub-text)

.page-container
  min-height 100vh
  background-color var(--hub-bg) !important
  background-image radial-gradient(circle at 82% 5%, rgba(37,99,235,.09), transparent 26%), radial-gradient(circle at 12% 42%, rgba(6,182,212,.055), transparent 24%), linear-gradient(rgba(100,116,139,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(100,116,139,.035) 1px, transparent 1px)
  background-size auto, auto, 44px 44px, 44px 44px
  background-attachment fixed

.main-content-container
  min-height 100vh

.main-content-body
  padding-top 34px !important
  padding-bottom 64px !important

.main-content-body .main-content
  max-width 1220px !important

.markdown-body
  color var(--hub-text)

.markdown-body p,
.markdown-body li
  line-height 1.82

.page-title-header
  color var(--hub-text)
  letter-spacing -.045em

.personal-hub-navbar
  background transparent !important
  padding-top 12px !important
  padding-bottom 6px !important
  backdrop-filter none !important
  -webkit-backdrop-filter none !important

.personal-hub-navbar .navbar-content
  height 58px
  max-width 1220px !important
  padding 0 10px 0 13px
  border 1px solid var(--hub-line)
  border-radius 18px
  background var(--hub-surface)
  -webkit-backdrop-filter blur(20px) saturate(140%)
  backdrop-filter blur(20px) saturate(140%)
  box-shadow 0 10px 35px rgba(15,23,42,.06)

.dark .personal-hub-navbar .navbar-content
  box-shadow 0 12px 38px rgba(0,0,0,.26)

.hub-brand
  display flex
  align-items center
  gap 10px
  color var(--hub-text) !important

.hub-brand-mark
  width 34px
  height 34px
  display inline-grid
  place-items center
  flex none
  border-radius 10px
  color #fff
  font-size 11px
  font-weight 850
  letter-spacing -.02em
  background linear-gradient(135deg, var(--hub-blue), var(--hub-cyan))
  box-shadow 0 8px 22px rgba(37,99,235,.22)

.hub-brand-copy
  display flex
  flex-direction column
  gap 3px

.hub-brand-copy strong
  font-size 13px
  line-height 1
  letter-spacing -.01em

.hub-brand-copy small
  color var(--hub-muted)
  font-size 7px
  line-height 1
  letter-spacing .14em
  font-weight 700

.hub-navbar-list
  gap 2px !important
  padding 0 4px !important
  border 1px solid var(--hub-line)
  border-radius 13px
  background rgba(100,116,139,.035)

.hub-nav-item
  margin 0 !important

.hub-nav-item a
  position relative
  padding 8px 10px !important
  border-radius 9px
  color var(--hub-muted) !important
  font-size 12px
  font-weight 650 !important
  letter-spacing 0 !important
  transition all .2s ease

.hub-nav-item a::after
  display none !important

.hub-nav-item a:hover
  color var(--hub-text) !important
  background rgba(37,99,235,.07)

.hub-nav-item a.active
  color var(--hub-blue) !important
  background rgba(37,99,235,.11)

.hub-nav-actions
  display flex
  align-items center
  gap 6px
  margin-left 12px

.hub-nav-icon
  width 34px
  height 34px
  display grid
  place-items center
  padding 0
  border 1px solid var(--hub-line)
  border-radius 10px
  background transparent
  color var(--hub-muted)
  cursor pointer
  transition all .2s ease

.hub-nav-icon:hover
  color var(--hub-blue)
  border-color var(--hub-line-strong)
  background rgba(37,99,235,.07)

.hub-lang-select
  height 34px
  border-color var(--hub-line) !important
  border-radius 10px !important
  background-color transparent !important
  font-size 11px !important

.hub-github-link
  height 34px
  display inline-flex
  align-items center
  gap 6px
  padding 0 10px
  border-radius 10px
  background var(--hub-text)
  color var(--hub-bg) !important
  font-size 11px
  font-weight 750
  transition transform .2s ease, opacity .2s ease

.hub-github-link:hover
  transform translateY(-2px)
  opacity .88

.hub-github-link b
  font-size 10px

.hub-mobile-actions
  display none !important

.personal-hub-navbar .navbar-drawer
  background var(--hub-bg) !important

.hub-drawer-head
  display flex
  gap 12px
  align-items center
  padding 28px 24px 12px
  color var(--hub-text)

.hub-drawer-head > span:last-child
  display flex
  flex-direction column
  gap 3px

.hub-drawer-head strong
  font-size 14px

.hub-drawer-head small
  color var(--hub-muted)
  font-size 8px
  letter-spacing .13em

.hub-drawer-list
  gap 3px

.hub-drawer-list .drawer-navbar-item
  margin 0 !important

.hub-drawer-list .drawer-navbar-item a
  width 100%
  display flex
  align-items center
  justify-content space-between
  padding 13px 12px
  border-bottom 1px solid var(--hub-line)
  color var(--hub-text)
  font-size 22px
  font-weight 750
  letter-spacing -.025em

.hub-drawer-list .drawer-navbar-item a.active
  color var(--hub-blue)

.hub-drawer-list .drawer-navbar-item i
  color var(--hub-muted)
  font-size 14px

.hub-drawer-bottom
  display flex
  align-items center
  justify-content space-between
  padding 20px 24px 30px
  color var(--hub-muted)
  font-size 12px

.hub-drawer-bottom .lang-select-mobile
  display block
  max-width 140px

.main-content > .page-content-container,
.main-content > .archive-content-container,
.main-content > .category-content-container,
.main-content > .tag-content-container
  border-radius 22px

.main-content-footer
  opacity .72

.footer-container
  border-top 1px solid var(--hub-line)

.hub-shell
  width min(1180px, calc(100% - 40px))
  margin 0 auto
  padding 36px 0 96px
  color var(--hub-text)

.hub-hero
  position relative
  overflow hidden
  min-height 490px
  padding 92px 64px 58px
  border 1px solid var(--hub-line)
  border-radius 30px
  background linear-gradient(135deg, rgba(37,99,235,.11), var(--hub-surface) 45%, rgba(6,182,212,.08))
  box-shadow var(--hub-shadow)

.hub-hero::before
  content ''
  position absolute
  inset 0
  pointer-events none
  background linear-gradient(120deg, transparent 10%, rgba(255,255,255,.10) 45%, transparent 60%)
  transform translateX(-110%)
  animation hubSheen 11s ease-in-out infinite

.hub-orb
  position absolute
  width 360px
  height 360px
  border-radius 50%
  filter blur(70px)
  opacity .20
  pointer-events none
  animation hubFloat 9s ease-in-out infinite

.hub-orb-a
  right -80px
  top -120px
  background #2563eb

.hub-orb-b
  right 180px
  bottom -250px
  background #06b6d4
  animation-delay -4s

.hub-kicker,.hub-eyebrow,.hub-card-tag
  font-size 11px
  font-weight 800
  letter-spacing .15em
  color var(--hub-blue)

.hub-kicker span
  display inline-block
  width 24px
  height 2px
  margin 0 10px 3px 0
  background var(--hub-blue)

.hub-hero h1
  position relative
  max-width 760px
  margin 25px 0 20px
  font-size clamp(48px, 7vw, 86px)
  line-height 1.02
  letter-spacing -.055em
  font-weight 850

.hub-hero p
  position relative
  max-width 650px
  font-size 18px
  line-height 1.8
  color var(--hub-muted)

.hub-actions
  position relative
  display flex
  gap 12px
  margin-top 34px

.hub-btn
  display inline-flex
  gap 20px
  align-items center
  padding 13px 20px
  border 1px solid var(--hub-line)
  border-radius 13px
  color var(--hub-text)
  background var(--hub-surface)
  font-weight 700
  transition .25s ease

.hub-btn:hover
  transform translateY(-3px)
  box-shadow 0 14px 30px rgba(15,23,42,.12)

.hub-btn-primary
  color white
  border-color transparent
  background linear-gradient(135deg, #2563eb, #0891b2)

.hub-tech
  position absolute
  right 45px
  bottom 34px
  display flex
  gap 18px
  font-size 9px
  font-weight 700
  letter-spacing .14em
  color var(--hub-muted)

.hub-section-head
  display flex
  align-items end
  justify-content space-between
  gap 30px
  margin 72px 4px 23px

.hub-section-head h2
  margin 7px 0 0
  font-size 34px
  letter-spacing -.035em

.hub-section-head p,.hub-section-head a
  color var(--hub-muted)

.hub-grid
  display grid
  gap 15px

.hub-grid-main
  grid-template-columns repeat(2,1fr)

.hub-card,.hub-post-card
  position relative
  overflow hidden
  padding 30px
  min-height 250px
  border 1px solid var(--hub-line)
  border-radius 20px
  background var(--hub-surface)
  color var(--hub-text)
  backdrop-filter blur(14px)
  transition transform .28s ease, box-shadow .28s ease, border-color .28s ease

.hub-card:hover,.hub-post-card:hover
  transform translateY(-6px)
  border-color var(--hub-line-strong)
  box-shadow var(--hub-shadow)

.hub-card::after
  content ''
  position absolute
  width 150px
  height 150px
  right -70px
  bottom -80px
  border-radius 50%
  background var(--hub-blue)
  opacity .05
  transition .35s ease

.hub-card:hover::after
  transform scale(1.5)

.hub-icon
  display grid
  place-items center
  width 44px
  height 44px
  margin-bottom 25px
  border-radius 12px
  background rgba(37,99,235,.10)
  color var(--hub-blue)
  font-size 19px
  font-weight 800

.hub-card h3,.hub-post-card h3
  margin 9px 0 10px
  font-size 24px
  letter-spacing -.025em

.hub-card p,.hub-post-card p
  color var(--hub-muted)
  line-height 1.7

.hub-card b
  position absolute
  left 30px
  bottom 26px
  font-size 13px
  color var(--hub-blue)

.hub-post-grid
  grid-template-columns repeat(3,1fr)

.hub-post-card
  min-height 285px

.hub-post-no
  position absolute
  right 24px
  top 20px
  font-size 34px
  font-weight 900
  color rgba(100,116,139,.12)

.hub-post-card div
  position absolute
  left 30px
  right 30px
  bottom 25px
  display flex
  justify-content space-between
  color var(--hub-muted)

@keyframes hubFloat
  0%,100% { transform: translate3d(0,0,0) scale(1) }
  50% { transform: translate3d(-30px,25px,0) scale(1.08) }

@keyframes hubSheen
  0%,78%,100% { transform: translateX(-110%) }
  88% { transform: translateX(110%) }

@media (max-width: 1060px)
  .hub-navbar-list
    display none !important

  .hub-github-link span
    display none

@media (max-width: 768px)
  .main-content-body
    padding-top 18px !important

  .personal-hub-navbar
    padding 8px 10px 0 !important

  .personal-hub-navbar .navbar-content
    height 52px
    border-radius 15px
    padding 0 10px

  .hub-brand-copy small
    display none

  .hub-nav-actions
    display none

  .hub-mobile-actions
    display flex !important
    align-items center

  .hub-mobile-actions .icon-item
    display flex !important
    margin-left 12px

  .hub-shell
    width min(100% - 24px, 1180px)
    padding-top 12px

  .hub-hero
    min-height 510px
    padding 66px 25px 40px
    border-radius 22px

  .hub-hero h1
    font-size 48px

  .hub-tech
    left 25px
    right auto
    flex-wrap wrap

  .hub-grid-main,.hub-post-grid
    grid-template-columns 1fr

  .hub-section-head
    align-items start
    flex-direction column

  .hub-actions
    flex-direction column
    align-items stretch

@media (prefers-reduced-motion: reduce)
  .hub-orb,.hub-card,.hub-post-card,.hub-btn,.hub-hero::before,.hub-nav-item a
    animation none
    transition none
