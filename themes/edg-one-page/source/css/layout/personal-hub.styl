:root
  --hub-bg #f5f7fb
  --hub-surface rgba(255,255,255,.78)
  --hub-text #101828
  --hub-muted #667085
  --hub-line rgba(15,23,42,.09)
  --hub-blue #2563eb
  --hub-cyan #2dd4bf
  --hub-purple #7c6cff
  --hub-shadow 0 22px 60px rgba(15,23,42,.09)
.dark
  --hub-bg #080d17
  --hub-surface rgba(14,22,37,.82)
  --hub-text #f5f7fb
  --hub-muted #98a2b3
  --hub-line rgba(255,255,255,.09)
  --hub-shadow 0 25px 70px rgba(0,0,0,.3)
html
  scroll-behavior smooth
body
  background var(--hub-bg)
  color var(--hub-text)
.page-container
  min-height 100vh
  background-color var(--hub-bg) !important
  background-image radial-gradient(circle at 76% 8%,rgba(37,99,235,.1),transparent 30%),linear-gradient(rgba(100,116,139,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(100,116,139,.025) 1px,transparent 1px)
  background-size auto,48px 48px,48px 48px
.main-content-body
  padding-top 28px !important
  padding-bottom 60px !important
.main-content-body .main-content
  max-width 1320px !important
.markdown-body
  color var(--hub-text)
.markdown-body p,.markdown-body li
  line-height 1.82
.personal-hub-navbar
  background transparent !important
  padding-top 10px !important
  backdrop-filter none !important
.personal-hub-navbar .navbar-content
  height 58px
  max-width 1320px !important
  padding 0 11px 0 14px
  border 1px solid var(--hub-line)
  border-radius 17px
  background var(--hub-surface)
  backdrop-filter blur(20px) saturate(140%)
  box-shadow 0 10px 35px rgba(15,23,42,.06)
.hub-brand
  display flex
  align-items center
  gap 10px
  color var(--hub-text) !important
.hub-brand-mark
  width 35px
  height 35px
  display inline-grid
  place-items center
  border-radius 10px
  color #fff
  font-size 12px
  font-weight 900
  background linear-gradient(135deg,var(--hub-purple),var(--hub-blue))
  box-shadow 0 8px 22px rgba(37,99,235,.25)
.hub-brand-copy
  display flex
  flex-direction column
  gap 3px
.hub-brand-copy strong
  font-size 13px
.hub-brand-copy small
  color var(--hub-muted)
  font-size 7px
  letter-spacing .14em
.hub-navbar-list
  gap 2px !important
  padding 0 4px !important
.hub-nav-item
  margin 0 !important
.hub-nav-item a
  padding 8px 11px !important
  border-radius 10px
  color var(--hub-muted) !important
  font-size 12px
  font-weight 650 !important
  transition .2s
.hub-nav-item a::after
  display none !important
.hub-nav-item a:hover,.hub-nav-item a.active
  color var(--hub-text) !important
  background rgba(37,99,235,.11)
.hub-nav-item a.active
  color #60a5fa !important
.hub-nav-actions
  display flex
  align-items center
  gap 6px
  margin-left 12px
.hub-nav-icon
  width 34px
  height 34px
  display grid
  place-items center
  padding 0
  border 1px solid var(--hub-line)
  border-radius 10px
  background transparent
  color var(--hub-muted)
  cursor pointer
.hub-lang-select
  height 34px
  border-color var(--hub-line) !important
  border-radius 10px !important
  background transparent !important
  font-size 11px !important
.hub-github-link
  height 34px
  display inline-flex
  align-items center
  gap 6px
  padding 0 10px
  border-radius 10px
  background var(--hub-text)
  color var(--hub-bg) !important
  font-size 11px
  font-weight 750
.hub-mobile-actions
  display none !important
.personal-hub-navbar .navbar-drawer
  background var(--hub-bg) !important
.hub-drawer-head,.hub-drawer-bottom
  display flex
  align-items center
  justify-content space-between
  padding 25px
.hub-drawer-head
  justify-content flex-start
  gap 12px
.hub-drawer-head>span:last-child
  display flex
  flex-direction column
.hub-drawer-head small
  color var(--hub-muted)
  font-size 8px
.hub-drawer-list .drawer-navbar-item a
  display flex
  justify-content space-between
  padding 13px 12px
  border-bottom 1px solid var(--hub-line)
  font-size 22px
  font-weight 750
.hub-drawer-list a.active
  color var(--hub-blue)
.hub-shell
  width min(1280px,calc(100% - 40px))
  margin 0 auto
  padding 22px 0 90px
.hub-hero-v2
  position relative
  overflow hidden
  min-height 520px
  padding 68px 55px
  border 1px solid var(--hub-line)
  border-radius 28px
  background radial-gradient(circle at 72% 30%,rgba(50,160,255,.22),transparent 26%),linear-gradient(120deg,rgba(7,14,27,.98),rgba(10,24,43,.93) 52%,rgba(8,18,34,.98))
  color #f7f9fc
  box-shadow var(--hub-shadow)
.hub-hero-v2::after
  content ''
  position absolute
  left 0
  right 0
  bottom 0
  height 48%
  background linear-gradient(165deg,transparent 25%,rgba(6,13,24,.45) 26%,rgba(6,13,24,.9) 65%),linear-gradient(15deg,transparent 30%,rgba(16,36,58,.7) 31%,rgba(5,12,23,.95) 70%)
  clip-path polygon(0 65%,15% 45%,26% 61%,43% 23%,54% 55%,66% 38%,80% 64%,91% 42%,100% 60%,100% 100%,0 100%)
  opacity .9
.hub-aurora
  position absolute
  width 55%
  height 70%
  right 5%
  top -20%
  background radial-gradient(ellipse,rgba(64,200,255,.24),transparent 65%)
  filter blur(30px)
  transform rotate(-12deg)
.hub-orb
  position absolute
  width 330px
  height 330px
  border-radius 50%
  filter blur(80px)
  opacity .15
  animation hubFloat 9s ease-in-out infinite
.hub-orb-a
  right -60px
  top -100px
  background #2563eb
.hub-orb-b
  left 35%
  bottom -250px
  background #2dd4bf
.hub-hero-copy
  position relative
  z-index 3
  width 55%
.hub-kicker,.hub-eyebrow
  font-size 11px
  font-weight 800
  letter-spacing .15em
  color #8da0ba
.hub-hero-v2 h1
  margin 12px 0 8px
  font-size clamp(54px,6vw,84px)
  line-height 1
  letter-spacing -.055em
  background linear-gradient(90deg,#5b8cff,#67e8d2)
  -webkit-background-clip text
  color transparent
.hub-role
  margin 14px 0 !important
  font-size 19px !important
  color #d4dbea !important
  letter-spacing .08em
.hub-intro
  max-width 540px
  color #aab5c7 !important
  font-size 16px !important
  line-height 1.9 !important
.hub-actions
  display flex
  gap 12px
  margin-top 28px
.hub-btn
  display inline-flex
  align-items center
  gap 12px
  padding 13px 20px
  border 1px solid rgba(255,255,255,.12)
  border-radius 14px
  background rgba(255,255,255,.07)
  color #f7f9fc !important
  font-weight 700
  transition .25s
.hub-btn:hover
  transform translateY(-3px)
.hub-btn-primary
  border 0
  background linear-gradient(100deg,#4d7dff,#55e1cc)
  color #07101d !important
.hub-hero-sign
  position absolute
  z-index 3
  right 8%
  top 17%
  transform rotate(-7deg)
  color rgba(231,240,255,.75)
  font-family cursive
  font-size 27px
  line-height 1.3
  text-align center
.hub-hero-sign small
  font-size 18px
.hub-stats
  position absolute
  z-index 4
  right 35px
  bottom 28px
  display grid
  grid-template-columns repeat(4,1fr)
  width 47%
  padding 17px 20px
  border 1px solid rgba(255,255,255,.12)
  border-radius 16px
  background rgba(12,23,42,.72)
  backdrop-filter blur(18px)
.hub-stats div
  display flex
  flex-direction column
  align-items center
  gap 3px
.hub-stats b
  font-size 20px
.hub-stats span
  color #9aa8bc
  font-size 11px
.hub-section-head
  display flex
  align-items end
  justify-content space-between
  gap 20px
  margin 58px 2px 18px
.hub-section-head h2
  margin 6px 0 0
  font-size 27px
  letter-spacing -.03em
.hub-section-head p,.hub-section-head a
  color var(--hub-muted)
.hub-compact-head
  margin-bottom 14px
.hub-compact-head p
  margin 4px 0 0
  font-size 13px
.hub-quick-grid
  display grid
  grid-template-columns repeat(6,1fr)
  gap 12px
.hub-quick-card
  min-height 135px
  display flex
  align-items flex-start
  gap 12px
  position relative
  padding 20px
  border 1px solid var(--hub-line)
  border-radius 16px
  background var(--hub-surface)
  color var(--hub-text)
  transition .25s
.hub-quick-card:hover
  transform translateY(-5px)
  border-color rgba(80,150,255,.35)
  box-shadow var(--hub-shadow)
.hub-icon
  width 38px
  height 38px
  display grid
  place-items center
  flex none
  border-radius 11px
  background rgba(37,99,235,.12)
  color #60a5fa
  font-weight 900
.hub-quick-card h3
  margin 3px 0 7px
  font-size 16px
.hub-quick-card p
  margin 0
  color var(--hub-muted)
  font-size 11px
  line-height 1.5
.hub-quick-card>b
  position absolute
  bottom 14px
  left 20px
  color #55d8d0
.hub-dashboard-grid
  display grid
  grid-template-columns 1.15fr 1.05fr .9fr
  gap 26px
.hub-row-head
  margin-top 48px
.hub-row-head h2
  font-size 21px
.hub-row-head a
  font-size 12px
  color #60a5fa
.hub-writing-list,.hub-tool-list
  display flex
  flex-direction column
  gap 9px
.hub-writing-list>a,.hub-tool-list>a
  display flex
  align-items center
  gap 13px
  min-height 72px
  padding 13px 15px
  border 1px solid var(--hub-line)
  border-radius 13px
  background var(--hub-surface)
  color var(--hub-text)
.hub-writing-icon,.hub-tool-list b
  width 42px
  height 42px
  display grid
  place-items center
  flex none
  border-radius 10px
  background rgba(37,99,235,.12)
  color #60a5fa
.hub-writing-list h3
  margin 0 0 5px
  font-size 14px
.hub-writing-list p
  margin 0
  color var(--hub-muted)
  font-size 10px
.hub-writing-list time
  margin-left auto
  color var(--hub-muted)
  font-size 10px
.hub-feature-project
  min-height 160px
  display grid
  grid-template-columns 42% 1fr
  gap 17px
  padding 15px
  border 1px solid var(--hub-line)
  border-radius 14px
  background var(--hub-surface)
  color var(--hub-text)
.hub-fish-art
  position relative
  display grid
  place-items center
  overflow hidden
  border-radius 11px
  background radial-gradient(circle at 50% 25%,#1b6c89,#0b2739 60%,#06141f)
.hub-fish-art::before,.hub-fish-art::after
  content ''
  position absolute
  width 160%
  height 1px
  background rgba(125,220,255,.15)
  box-shadow 0 18px rgba(125,220,255,.1),0 36px rgba(125,220,255,.08)
.hub-fish-art span
  font-size 55px
  color #9bdff2
  transform rotate(8deg)
.hub-live
  font-size 10px
  color #2dd4bf
.hub-feature-project h3
  margin 8px 0
  font-size 17px
.hub-feature-project p
  color var(--hub-muted)
  font-size 11px
  line-height 1.65
.hub-mini-tags
  display flex
  gap 5px
  flex-wrap wrap
.hub-mini-tags span
  padding 4px 7px
  border-radius 999px
  background rgba(100,116,139,.15)
  font-size 9px
.hub-tool-list>a
  min-height 48px
  padding 9px 12px
.hub-tool-list b
  width 36px
  height 36px
.hub-tool-list span
  display flex
  flex-direction column
.hub-tool-list strong
  font-size 12px
.hub-tool-list small
  margin-top 3px
  color var(--hub-muted)
  font-size 9px
.hub-empty
  color var(--hub-muted)
  padding 20px
@keyframes hubFloat
  0%,100% {transform:translate3d(0,0,0)}
  50% {transform:translate3d(-25px,20px,0)}
@media(max-width:1100px)
  .hub-navbar-list
    display none !important
  .hub-quick-grid
    grid-template-columns repeat(3,1fr)
  .hub-dashboard-grid
    grid-template-columns 1fr 1fr
  .hub-dashboard-grid section:last-child
    grid-column 1/-1
@media(max-width:768px)
  .personal-hub-navbar
    padding 8px 10px 0 !important
  .personal-hub-navbar .navbar-content
    height 52px
  .hub-nav-actions
    display none
  .hub-mobile-actions
    display flex !important
  .hub-shell
    width calc(100% - 24px)
  .hub-hero-v2
    min-height 650px
    padding 55px 25px
  .hub-hero-copy
    width 100%
  .hub-hero-sign
    display none
  .hub-stats
    left 20px
    right 20px
    bottom 25px
    width auto
  .hub-quick-grid,.hub-dashboard-grid
    grid-template-columns 1fr
  .hub-dashboard-grid section:last-child
    grid-column auto
  .hub-section-head
    align-items flex-start
  .hub-feature-project
    grid-template-columns 1fr
  .hub-fish-art
    min-height 150px
@media(max-width:480px)
  .hub-quick-grid
    grid-template-columns 1fr 1fr
  .hub-stats
    grid-template-columns repeat(2,1fr)
    gap 12px
  .hub-writing-list time
    display none
@media(prefers-reduced-motion:reduce)
  .hub-orb,.hub-btn,.hub-quick-card
    animation none
    transition none