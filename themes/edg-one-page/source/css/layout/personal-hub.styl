:root
  --hub-bg #f5f7fb
  --hub-surface rgba(255,255,255,.78)
  --hub-text #101828
  --hub-muted #667085
  --hub-line rgba(15,23,42,.09)
  --hub-blue #4f46e5
  --hub-cyan #8b5cf6
  --hub-purple #7c3aed
  --hub-shadow 0 22px 60px rgba(15,23,42,.09)
.dark
  --hub-bg #080d17
  --hub-surface rgba(14,22,37,.82)
  --hub-text #f5f7fb
  --hub-muted #98a2b3
  --hub-line rgba(255,255,255,.09)
  --hub-shadow 0 25px 70px rgba(0,0,0,.3)
@css {
html{scroll-behavior:smooth}
body{background:var(--hub-bg);color:var(--hub-text)}
.page-container{min-height:100vh;background-color:var(--hub-bg)!important;background-image:radial-gradient(circle at 76% 8%,rgba(79,70,229,.1),transparent 30%),linear-gradient(rgba(100,116,139,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(100,116,139,.025) 1px,transparent 1px);background-size:auto,48px 48px,48px 48px}
.main-content-body{padding-top:28px!important;padding-bottom:60px!important}.main-content-body .main-content{max-width:1320px!important}.markdown-body{color:var(--hub-text)}.markdown-body p,.markdown-body li{line-height:1.82}
.personal-hub-navbar{background:transparent!important;padding-top:10px!important;backdrop-filter:none!important}.personal-hub-navbar .navbar-content{height:68px;max-width:1400px!important;padding:0 16px 0 18px;border:1px solid var(--hub-line);border-radius:17px;background:var(--hub-surface);backdrop-filter:blur(20px) saturate(140%);box-shadow:0 10px 35px rgba(15,23,42,.06)}.personal-hub-navbar .right{display:flex;align-items:center;gap:14px}
.hub-brand{display:flex;align-items:center;gap:10px;color:var(--hub-text)!important}.hub-brand-mark{width:42px;height:42px;display:inline-grid;place-items:center;border-radius:10px;color:#fff;font-size:12px;font-weight:900;background:linear-gradient(135deg,var(--hub-purple),var(--hub-blue));box-shadow:0 8px 22px rgba(79,70,229,.25)}.hub-brand-copy{display:flex;flex-direction:column;gap:3px}.hub-brand-copy strong{font-size:13px}.hub-brand-copy small{color:var(--hub-muted);font-size:7px;letter-spacing:.14em}.hub-navbar-list{gap:2px!important;padding:0 4px!important}.hub-nav-item{margin:0!important}.hub-nav-item a{padding:8px 11px!important;border-radius:10px;color:var(--hub-muted)!important;font-size:12px;font-weight:650!important;transition:.2s}.hub-nav-item a::after{display:none!important}.hub-nav-item a:hover,.hub-nav-item a.active{color:var(--hub-text)!important;background:rgba(79,70,229,.11)}.hub-nav-item a.active{color:#a5b4fc!important}.hub-nav-actions{display:flex;align-items:center;gap:6px;margin-left:12px}.hub-nav-icon{width:34px;height:34px;display:grid;place-items:center;padding:0;border:1px solid var(--hub-line);border-radius:10px;background:transparent;color:var(--hub-muted);cursor:pointer}.hub-lang-select{height:34px;border-color:var(--hub-line)!important;border-radius:10px!important;background:transparent!important;font-size:11px!important}.hub-github-link{height:34px;display:inline-flex;align-items:center;gap:6px;padding:0 10px;border-radius:10px;background:var(--hub-text);color:var(--hub-bg)!important;font-size:11px;font-weight:750}.hub-mobile-actions{display:none!important}.personal-hub-navbar .navbar-drawer{background:var(--hub-bg)!important}.hub-drawer-head,.hub-drawer-bottom{display:flex;align-items:center;justify-content:space-between;padding:25px}.hub-drawer-head{justify-content:flex-start;gap:12px}.hub-drawer-head>span:last-child{display:flex;flex-direction:column}.hub-drawer-head small{color:var(--hub-muted);font-size:8px}.hub-drawer-list .drawer-navbar-item a{display:flex;justify-content:space-between;padding:13px 12px;border-bottom:1px solid var(--hub-line);font-size:22px;font-weight:750}.hub-drawer-list a.active{color:var(--hub-blue)}
.hub-shell{width:min(1280px,calc(100% - 40px));margin:0 auto;padding:22px 0 90px}.hub-hero-v2{position:relative;overflow:hidden;min-height:520px;padding:68px 55px;border:1px solid var(--hub-line);border-radius:28px;background:radial-gradient(circle at 72% 30%,rgba(129,140,248,.22),transparent 26%),linear-gradient(120deg,rgba(14,13,34,.98),rgba(23,22,56,.93) 52%,rgba(19,17,46,.98));color:#f7f9fc;box-shadow:var(--hub-shadow)}.hub-hero-v2::after{content:'';position:absolute;left:0;right:0;bottom:0;height:48%;background:linear-gradient(165deg,transparent 25%,rgba(10,9,26,.45) 26%,rgba(10,9,26,.9) 65%),linear-gradient(15deg,transparent 30%,rgba(32,28,72,.7) 31%,rgba(9,8,23,.95) 70%);clip-path:polygon(0 65%,15% 45%,26% 61%,43% 23%,54% 55%,66% 38%,80% 64%,91% 42%,100% 60%,100% 100%,0 100%);opacity:.9}.hub-aurora{position:absolute;width:55%;height:70%;right:5%;top:-20%;background:radial-gradient(ellipse,rgba(139,92,246,.24),transparent 65%);filter:blur(30px);transform:rotate(-12deg)}.hub-orb{position:absolute;width:330px;height:330px;border-radius:50%;filter:blur(80px);opacity:.15;animation:hubFloat 9s ease-in-out infinite}.hub-orb-a{right:-60px;top:-100px;background:#4f46e5}.hub-orb-b{left:35%;bottom:-250px;background:#8b5cf6}.hub-hero-copy{position:relative;z-index:3;width:55%}.hub-kicker,.hub-eyebrow{font-size:11px;font-weight:800;letter-spacing:.15em;color:#8da0ba}.hub-hero-v2 h1{margin:12px 0 8px;font-size:clamp(54px,6vw,84px);line-height:1;letter-spacing:-.055em;background:linear-gradient(90deg,#a5b4fc,#c4b5fd);-webkit-background-clip:text;color:transparent}.hub-role{margin:14px 0!important;font-size:19px!important;color:#d4dbea!important;letter-spacing:.08em}.hub-intro{max-width:540px;color:#aab5c7!important;font-size:16px!important;line-height:1.9!important}.hub-actions{display:flex;gap:12px;margin-top:28px}.hub-btn{display:inline-flex;align-items:center;gap:12px;padding:13px 20px;border:1px solid rgba(255,255,255,.12);border-radius:14px;background:rgba(255,255,255,.07);color:#f7f9fc!important;font-weight:700;transition:.25s}.hub-btn:hover{transform:translateY(-3px)}.hub-btn-primary{border:0;background:linear-gradient(100deg,#6366f1,#a78bfa);color:#0d0c22!important}.hub-hero-sign{position:absolute;z-index:3;right:8%;top:17%;transform:rotate(-7deg);color:rgba(224,231,255,.75);font-family:cursive;font-size:27px;line-height:1.3;text-align:center}.hub-hero-sign small{font-size:18px}.hub-stats{position:absolute;z-index:4;right:35px;bottom:28px;display:grid;grid-template-columns:repeat(4,1fr);width:47%;padding:17px 20px;border:1px solid rgba(255,255,255,.12);border-radius:16px;background:rgba(12,23,42,.72);backdrop-filter:blur(18px)}.hub-stats div{display:flex;flex-direction:column;align-items:center;gap:3px}.hub-stats b{font-size:20px}.hub-stats span{color:#9aa8bc;font-size:11px}.hub-section-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin:58px 2px 18px}.hub-section-head h2{margin:6px 0 0;font-size:27px;letter-spacing:-.03em}.hub-section-head p,.hub-section-head a{color:var(--hub-muted)}.hub-compact-head{margin-bottom:14px}.hub-compact-head p{margin:4px 0 0;font-size:13px}.hub-quick-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:12px}.hub-quick-card{min-height:135px;display:flex;align-items:flex-start;gap:12px;position:relative;padding:20px;border:1px solid var(--hub-line);border-radius:16px;background:var(--hub-surface);color:var(--hub-text);transition:.25s}.hub-quick-card:hover{transform:translateY(-5px);border-color:rgba(129,140,248,.35);box-shadow:var(--hub-shadow)}.hub-icon{width:38px;height:38px;display:grid;place-items:center;flex:none;border-radius:11px;background:rgba(79,70,229,.12);color:#a5b4fc;font-weight:900}.hub-quick-card h3{margin:3px 0 7px;font-size:16px}.hub-quick-card p{margin:0;color:var(--hub-muted);font-size:11px;line-height:1.5}.hub-quick-card>b{position:absolute;bottom:14px;left:20px;color:#a78bfa}.hub-dashboard-grid{display:grid;grid-template-columns:1.15fr 1.05fr .9fr;gap:26px}.hub-row-head{margin-top:48px}.hub-row-head h2{font-size:21px}.hub-row-head a{font-size:12px;color:#a5b4fc}.hub-writing-list,.hub-tool-list{display:flex;flex-direction:column;gap:9px}.hub-writing-list>a,.hub-tool-list>a{display:flex;align-items:center;gap:13px;min-height:72px;padding:13px 15px;border:1px solid var(--hub-line);border-radius:13px;background:var(--hub-surface);color:var(--hub-text)}.hub-writing-icon,.hub-tool-list b{width:42px;height:42px;display:grid;place-items:center;flex:none;border-radius:10px;background:rgba(79,70,229,.12);color:#a5b4fc}.hub-writing-list h3{margin:0 0 5px;font-size:14px}.hub-writing-list p{margin:0;color:var(--hub-muted);font-size:10px}.hub-writing-list time{margin-left:auto;color:var(--hub-muted);font-size:10px}.hub-feature-project{min-height:160px;display:grid;grid-template-columns:42% 1fr;gap:17px;padding:15px;border:1px solid var(--hub-line);border-radius:14px;background:var(--hub-surface);color:var(--hub-text)}.hub-fish-art{position:relative;display:grid;place-items:center;overflow:hidden;border-radius:11px;background:radial-gradient(circle at 50% 25%,#5b4bb8,#1a1740 60%,#12102e)}.hub-fish-art::before,.hub-fish-art::after{content:'';position:absolute;width:160%;height:1px;background:rgba(167,139,250,.15);box-shadow:0 18px rgba(167,139,250,.1),0 36px rgba(167,139,250,.08)}.hub-fish-art span{font-size:55px;color:#c4b5fd;transform:rotate(8deg)}.hub-live{font-size:10px;color:#8b5cf6}.hub-feature-project h3{margin:8px 0;font-size:17px}.hub-feature-project p{color:var(--hub-muted);font-size:11px;line-height:1.65}.hub-mini-tags{display:flex;gap:5px;flex-wrap:wrap}.hub-mini-tags span{padding:4px 7px;border-radius:999px;background:rgba(100,116,139,.15);font-size:9px}.hub-tool-list>a{min-height:48px;padding:9px 12px}.hub-tool-list b{width:36px;height:36px}.hub-tool-list span{display:flex;flex-direction:column}.hub-tool-list strong{font-size:12px}.hub-tool-list small{margin-top:3px;color:var(--hub-muted);font-size:9px}
.workspace-page{width:min(1220px,calc(100% - 28px));margin:0 auto;padding:28px 0 70px;color:var(--hub-text)}.workspace-hero{position:relative;overflow:hidden;padding:42px 42px 34px;border:1px solid var(--hub-line);border-radius:23px;background:linear-gradient(125deg,rgba(79,70,229,.1),var(--hub-surface) 55%,rgba(139,92,246,.06));box-shadow:0 16px 45px rgba(15,23,42,.05)}.workspace-hero::after{content:'';position:absolute;width:300px;height:300px;right:-100px;top:-160px;border-radius:50%;background:#4f46e5;filter:blur(70px);opacity:.13}.workspace-kicker,.workspace-content-head small{color:#a5b4fc;font-size:10px;font-weight:800;letter-spacing:.15em}.workspace-hero h1{margin:8px 0 10px;font-size:clamp(38px,5vw,62px);letter-spacing:-.05em}.workspace-hero p{max-width:690px;margin:0;color:var(--hub-muted);font-size:15px}.workspace-search{position:relative;z-index:2;max-width:650px;height:48px;display:flex;align-items:center;gap:10px;margin-top:26px;padding:0 14px;border:1px solid var(--hub-line);border-radius:13px;background:var(--hub-bg)}.workspace-search input{flex:1;border:0!important;outline:0;background:transparent!important;color:var(--hub-text)!important;font-size:13px}.workspace-search kbd{padding:3px 7px;border:1px solid var(--hub-line);border-radius:6px;color:var(--hub-muted);font-size:9px}.workspace-layout,.toolbox-layout{display:grid;grid-template-columns:220px minmax(0,1fr);gap:28px;margin-top:28px}.workspace-sidebar{display:flex;flex-direction:column;gap:4px}.workspace-sidebar>b{padding:0 10px 10px;font-size:11px;color:var(--hub-muted)}.workspace-sidebar button{display:flex;justify-content:space-between;padding:10px 11px;border:0;border-radius:10px;background:transparent;color:var(--hub-muted);font-size:12px;text-align:left;cursor:pointer}.workspace-sidebar button:hover,.workspace-sidebar button.active{background:rgba(79,70,229,.1);color:#a5b4fc}.workspace-sidebar button span{opacity:.55}.workspace-side-card{margin-top:18px;padding:17px;border:1px solid var(--hub-line);border-radius:13px;background:var(--hub-surface)}.workspace-side-card small{color:#8b5cf6;font-size:8px;letter-spacing:.12em}.workspace-side-card strong{display:block;margin:7px 0;font-size:12px}.workspace-side-card p{margin:0 0 10px;color:var(--hub-muted);font-size:10px;line-height:1.55}.workspace-side-card a{color:#a5b4fc;font-size:10px}.workspace-content-head{display:flex;align-items:end;justify-content:space-between;margin-bottom:12px}.workspace-content-head h2{margin:4px 0 0;font-size:22px}.workspace-content-head>span{color:var(--hub-muted);font-size:10px}.note-list{display:flex;flex-direction:column;gap:9px}.note-list article{display:grid;grid-template-columns:46px 1fr auto;align-items:center;gap:15px;padding:17px 18px;border:1px solid var(--hub-line);border-radius:14px;background:var(--hub-surface);transition:.22s}.note-list article:hover{transform:translateX(5px);border-color:rgba(165,180,252,.32);box-shadow:0 12px 30px rgba(15,23,42,.06)}.note-list article[hidden]{display:none}.note-icon{width:46px;height:46px;display:grid;place-items:center;border-radius:12px;background:rgba(79,70,229,.1);color:#a5b4fc;font-size:18px}.note-list small{color:#a5b4fc;font-size:8px;font-weight:800;letter-spacing:.11em}.note-list h3{margin:4px 0;font-size:15px}.note-list p{margin:0;color:var(--hub-muted);font-size:11px;line-height:1.55}.note-list article div div{display:flex;gap:5px;margin-top:8px}.note-list em{padding:3px 7px;border-radius:999px;background:rgba(100,116,139,.1);color:var(--hub-muted);font-size:8px;font-style:normal}.note-list article>b{color:var(--hub-muted)}
.tool-app-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.tool-app-grid>button{min-height:92px;display:grid;grid-template-columns:48px 1fr auto;align-items:center;gap:13px;padding:16px;border:1px solid var(--hub-line);border-radius:14px;background:var(--hub-surface);color:var(--hub-text);text-align:left;cursor:pointer;transition:.22s}.tool-app-grid>button:hover{transform:translateY(-3px);border-color:rgba(165,180,252,.35);box-shadow:0 13px 32px rgba(15,23,42,.07)}.tool-app-grid>button[hidden]{display:none}.tool-app-grid>button>span{width:48px;height:48px;display:grid;place-items:center;border-radius:12px;background:rgba(79,70,229,.11);color:#a5b4fc;font-size:14px;font-weight:850}.tool-app-grid b{display:block;font-size:14px}.tool-app-grid small{display:block;margin-top:5px;color:var(--hub-muted);font-size:10px}.tool-app-grid i{color:var(--hub-muted);font-style:normal}.tool-panel{margin-top:20px;padding:25px;border:1px solid rgba(165,180,252,.22);border-radius:18px;background:var(--hub-surface);box-shadow:var(--hub-shadow);scroll-margin-top:90px}.tool-panel[hidden]{display:none}.tool-panel-head{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:17px}.tool-panel-head small{color:#8b5cf6;font-size:8px;font-weight:800;letter-spacing:.14em}.tool-panel-head h2{margin:5px 0;font-size:23px}.tool-panel-head p{margin:0;color:var(--hub-muted);font-size:11px}.tool-panel-head>button{width:34px;height:34px;border:1px solid var(--hub-line);border-radius:9px;background:transparent;color:var(--hub-muted);font-size:20px;cursor:pointer}.tool-panel textarea,.tool-input{width:100%;min-height:150px;box-sizing:border-box;padding:14px;border:1px solid var(--hub-line)!important;border-radius:11px;background:var(--hub-bg)!important;color:var(--hub-text)!important;font:12px/1.65 monospace;outline:none}.tool-input{min-height:46px;height:46px}.tool-actions{display:flex;gap:8px;margin:10px 0}.tool-actions button{padding:9px 14px;border:0;border-radius:9px;background:#4f46e5;color:white;font-size:11px;font-weight:700;cursor:pointer}.tool-panel pre{min-height:70px;max-height:330px;overflow:auto;margin:10px 0 0;padding:14px;border:1px solid var(--hub-line);border-radius:11px;background:rgba(15,13,32,.94);color:#cbd5e1;white-space:pre-wrap;word-break:break-word;font-size:11px}.tool-panel pre.error{color:#fca5a5}.radix-results{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:10px}.radix-results div,.timestamp-now{padding:15px;border:1px solid var(--hub-line);border-radius:11px;background:var(--hub-bg)}.radix-results small,.timestamp-now small{display:block;color:var(--hub-muted);font-size:8px;letter-spacing:.1em}.radix-results b,.timestamp-now b{display:block;margin-top:7px;font-family:monospace;font-size:14px;word-break:break-all}.timestamp-now{margin-bottom:10px}.timestamp-now b{font-size:24px;color:#a5b4fc}.diff-inputs{display:grid;grid-template-columns:1fr 1fr;gap:10px}
@keyframes hubFloat{0%,100%{transform:translate3d(0,0,0)}50%{transform:translate3d(-25px,20px,0)}}
@media(max-width:1100px){.hub-navbar-list{display:none!important}.hub-mobile-actions{display:flex!important;align-items:center;gap:8px}.hub-mobile-actions .search{display:none!important}.hub-mobile-actions .navbar-bar{display:flex!important;align-items:center;justify-content:center;width:34px;height:34px;margin-left:0;border:1px solid var(--hub-line);border-radius:10px}.hub-quick-grid{grid-template-columns:repeat(3,1fr)}.hub-dashboard-grid{grid-template-columns:1fr 1fr}.hub-dashboard-grid section:last-child{grid-column:1/-1}}
@media(max-width:768px){.personal-hub-navbar{padding:8px 10px 0!important}.personal-hub-navbar .navbar-content{height:52px}.hub-nav-actions{display:none}.hub-mobile-actions{display:flex!important}.hub-mobile-actions .search{display:flex!important}.hub-shell{width:calc(100% - 24px)}.hub-hero-v2{min-height:650px;padding:55px 25px}.hub-hero-copy{width:100%}.hub-hero-sign{display:none}.hub-stats{left:20px;right:20px;bottom:25px;width:auto}.hub-quick-grid,.hub-dashboard-grid{grid-template-columns:1fr}.hub-dashboard-grid section:last-child{grid-column:auto}.hub-feature-project{grid-template-columns:1fr}.workspace-page{width:calc(100% - 18px);padding-top:12px}.workspace-hero{padding:30px 22px}.workspace-layout,.toolbox-layout{grid-template-columns:1fr}.workspace-sidebar{display:grid;grid-template-columns:1fr 1fr}.workspace-sidebar>b,.workspace-side-card{grid-column:1/-1}.tool-app-grid{grid-template-columns:1fr}}
@media(max-width:480px){.hub-quick-grid{grid-template-columns:1fr 1fr}.hub-stats{grid-template-columns:repeat(2,1fr);gap:12px}.hub-writing-list time{display:none}.note-list article{grid-template-columns:40px 1fr}.note-list article>b{display:none}.diff-inputs,.radix-results{grid-template-columns:1fr}}
@media(prefers-reduced-motion:reduce){.hub-orb,.hub-btn,.hub-quick-card,.note-list article,.tool-app-grid>button{animation:none;transition:none}}
.note-list .note-card{display:block;color:inherit;text-decoration:none}
}

.hub-brand-mark img{width:100%;height:100%;object-fit:cover;border-radius:inherit;display:block}
