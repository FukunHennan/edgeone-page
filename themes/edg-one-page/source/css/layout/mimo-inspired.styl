@css {
:root {
  --mimo-paper: #f8f8f5;
  --mimo-ink: #171a16;
  --mimo-muted: #686e64;
  --mimo-line: #d9ddd4;
  --mimo-green: #667c5b;
  --mimo-ease: cubic-bezier(.22, 1, .36, 1);
  --hub-bg: var(--mimo-paper);
  --hub-surface: #fff;
  --hub-text: var(--mimo-ink);
  --hub-muted: var(--mimo-muted);
  --hub-line: var(--mimo-line);
  --hub-blue: var(--mimo-green);
  --hub-purple: var(--mimo-green);
  --hub-shadow: 0 20px 45px rgba(31, 47, 27, .07);
}
.dark {
  --mimo-paper: #161b17;
  --mimo-ink: #f3f4ef;
  --mimo-muted: #a4ada0;
  --mimo-line: #394337;
  --mimo-green: #b6cba8;
  --hub-bg: var(--mimo-paper);
  --hub-surface: #202820;
  --hub-text: var(--mimo-ink);
  --hub-muted: var(--mimo-muted);
  --hub-line: var(--mimo-line);
  --hub-blue: var(--mimo-green);
  --hub-purple: var(--mimo-green);
}
html { scrollbar-color: #b6bfb0 transparent; }
body, .page-container { background: var(--mimo-paper) !important; }
.page-container { background-image: none !important; }
.personal-hub-navbar { position: fixed; top: 0; left: 0; right: 0; z-index: 100; height: 76px !important; padding: 0 28px !important; background: var(--mimo-paper) !important; border-bottom: 1px solid var(--mimo-line); }
.personal-hub-navbar .navbar-content { height: 76px; max-width: 1500px !important; padding: 0 !important; border: 0; border-radius: 0; background: transparent; box-shadow: none; backdrop-filter: none; }
.hub-brand-mark { width: 36px; height: 36px; border-radius: 50%; background: transparent; box-shadow: none; }
.hub-brand-copy strong { font-size: 18px; font-weight: 760; letter-spacing: -.04em; }
.hub-brand-copy small { font-size: 8px; letter-spacing: .12em; }
.hub-nav-item a { color: var(--mimo-ink) !important; font-size: 13px; font-weight: 500 !important; background: transparent !important; }
.hub-nav-item a:hover, .hub-nav-item a.active { color: var(--mimo-green) !important; }
.hub-nav-icon { border: 0; border-radius: 50%; color: var(--mimo-ink); }
.hub-nav-icon:hover { background: rgba(102, 124, 91, .1); }
.hub-github-link { height: 40px; padding: 0 18px; border-radius: 9px; background: var(--mimo-ink); color: var(--mimo-paper) !important; }
.hub-github-link:hover { opacity: .82; }
.hub-lang-label { color: var(--mimo-ink); }
.home-mimo-page .main-content-container { padding-top: 0 !important; }
.home-mimo-page .main-content-body { padding-top: 0 !important; }
.mimo-home-hero { position: relative; padding: 154px 28px 24px; background: var(--mimo-paper); color: var(--mimo-ink); }
.mimo-home-copy { max-width: 1050px; margin: 0 auto 54px; text-align: center; }
.mimo-home-kicker { margin: 0 0 24px; color: var(--mimo-green); font-size: 12px; font-weight: 700; letter-spacing: .24em; }
.mimo-home-copy h1 { display: flex; flex-direction: column; gap: 6px; margin: 0; font-size: clamp(42px, 5.6vw, 82px); font-weight: 440; line-height: 1.22; letter-spacing: -.055em; }
.mimo-home-copy h1 span { display: block; }
.mimo-home-description { max-width: 620px; margin: 24px auto 0; color: var(--mimo-muted); font-size: clamp(14px, 1.4vw, 17px); line-height: 1.8; }
.mimo-home-actions { display: flex; justify-content: center; gap: 12px; margin-top: 32px; }
.mimo-home-button { display: inline-flex; justify-content: center; align-items: center; gap: 30px; min-width: 170px; min-height: 48px; padding: 0 24px; border: 1px solid var(--mimo-ink); border-radius: 999px; color: var(--mimo-ink); font-size: 14px; font-weight: 600; transition: transform .35s var(--mimo-ease), background .35s, color .35s, box-shadow .35s; }
.mimo-home-button-primary { background: var(--mimo-ink); color: var(--mimo-paper); }
.mimo-home-button:hover { transform: translateY(-4px); background: var(--mimo-green); border-color: var(--mimo-green); color: var(--mimo-paper); box-shadow: 0 12px 28px rgba(56, 77, 46, .16); }
.mimo-home-button span { transition: transform .35s var(--mimo-ease); }
.mimo-home-button:hover span { transform: translate(3px, -3px); }
.mimo-home-art { --pointer-x: 0px; --pointer-y: 0px; position: relative; isolation: isolate; width: min(1480px, 100%); height: clamp(350px, 41vw, 580px); margin: 0 auto; overflow: hidden; border-radius: 25px; background: #bac9ae; box-shadow: inset 0 0 0 1px rgba(52, 75, 43, .1); }
.mimo-home-art::before { content: ''; position: absolute; inset: -20%; z-index: -2; background: radial-gradient(ellipse at 15% 18%, #f4f3e9 0, transparent 28%), radial-gradient(ellipse at 85% 20%, #d7e0cc 0, transparent 38%), radial-gradient(ellipse at 50% 105%, #708d67 0, transparent 55%); animation: mimoDrift 15s ease-in-out infinite alternate; }
.mimo-home-art::after { content: ''; position: absolute; inset: 0; z-index: 3; border-radius: inherit; border: 1px solid rgba(255, 255, 255, .35); pointer-events: none; }
.mimo-art-halo { position: absolute; width: 55%; aspect-ratio: 1; border-radius: 50%; background: #f7f6ec; filter: blur(14px); opacity: .82; }
.mimo-art-halo-one { top: -66%; left: 5%; transform: translate(var(--pointer-x), var(--pointer-y)); }
.mimo-art-halo-two { right: -12%; bottom: -102%; background: #58764f; opacity: .65; transform: translate(calc(var(--pointer-x) * -.6), calc(var(--pointer-y) * -.6)); }
.mimo-art-dots { position: absolute; inset: 0; z-index: 1; background-image: radial-gradient(circle, rgba(44, 68, 39, .65) 1px, transparent 1.35px); background-size: 5px 5px; opacity: .8; mask-image: linear-gradient(110deg, #000 8%, transparent 44%, #000 75%); }
.mimo-art-word { position: absolute; z-index: 2; inset: 0; display: flex; align-items: center; justify-content: center; color: #40583a; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(100px, 25vw, 360px); font-weight: 400; letter-spacing: -.12em; line-height: 1; transform: translate(calc(var(--pointer-x) * .35), calc(var(--pointer-y) * .35)); transition: transform .8s var(--mimo-ease); }
.mimo-art-word span { color: #f6f5e9; font-size: .55em; }
.mimo-art-caption { position: absolute; z-index: 4; left: 30px; bottom: 27px; display: flex; gap: 17px; color: #f8f9f3; font-size: 11px; font-weight: 700; letter-spacing: .2em; }
.mimo-art-index { position: absolute; z-index: 4; right: 32px; bottom: 27px; color: #f8f9f3; font-family: Georgia, serif; font-size: 18px; }
.mimo-scroll-cue { display: flex; align-items: center; justify-content: space-between; width: min(1480px, 100%); margin: 17px auto 0; color: var(--mimo-muted); font-size: 11px; letter-spacing: .12em; }
.mimo-scroll-cue span:last-child { font-size: 22px; animation: mimoBounce 2s ease-in-out infinite; }
.hub-shell { padding-top: 16px; }
.hub-section-head { margin-top: 70px; }
.hub-eyebrow { color: var(--mimo-green) !important; }
.hub-section-head h2 { color: var(--mimo-ink); font-size: clamp(28px, 3vw, 43px); font-weight: 480; }
.hub-quick-grid { gap: 14px; }
.hub-quick-card, .hub-writing-list > a, .hub-tool-list > a, .hub-feature-project { border-color: var(--mimo-line); background: var(--hub-surface); box-shadow: none; }
.hub-quick-card { min-height: 158px; border-radius: 17px; }
.hub-quick-card:hover, .hub-writing-list a:hover, .hub-tool-list a:hover, .hub-feature-project:hover { border-color: var(--mimo-green); box-shadow: var(--hub-shadow); }
.hub-icon, .hub-writing-icon, .hub-tool-list b { background: #eaf0e5; color: #496344; }
.hub-quick-card > b, .hub-row-head a, .hub-live { color: var(--mimo-green); }
.hub-fish-art { background: radial-gradient(circle at 60% 35%, #b5caa7, #597553 70%); }
.hub-fish-art span { color: #f7f8ef; }
.hub-mini-tags span { background: #ebefe7; color: #4e6449; }
.dark .hub-icon, .dark .hub-writing-icon, .dark .hub-tool-list b, .dark .hub-mini-tags span { background: #334532; color: #d2e3c8; }
.mimo-reveal { opacity: 0; transform: translateY(38px); transition: opacity .8s var(--mimo-ease), transform .8s var(--mimo-ease); }
.mimo-reveal.is-visible { opacity: 1; transform: none; }
.hub-quick-card.mimo-reveal { transition-delay: var(--reveal-delay, 0ms); }
@keyframes mimoDrift { to { transform: translate3d(3%, -3%, 0) scale(1.08); } }
@keyframes mimoBounce { 50% { transform: translateY(6px); } }
@media (max-width: 900px) {
  .personal-hub-navbar { padding: 0 20px !important; }
  .mimo-home-hero { padding-top: 126px; }
  .mimo-home-copy { margin-bottom: 42px; }
  .mimo-home-art { height: 440px; }
  .mimo-art-word { font-size: clamp(110px, 24vw, 250px); }
}
@media (max-width: 600px) {
  .personal-hub-navbar { height: 60px !important; padding: 0 16px !important; }
  .personal-hub-navbar .navbar-content { height: 60px; }
  .mimo-home-hero { padding: 112px 14px 20px; }
  .mimo-home-kicker { font-size: 10px; }
  .mimo-home-copy h1 { gap: 9px; font-size: clamp(36px, 9vw, 54px); }
  .mimo-home-description { max-width: 340px; font-size: 13px; }
  .mimo-home-actions { gap: 9px; }
  .mimo-home-button { min-width: 0; min-height: 44px; gap: 13px; padding: 0 17px; font-size: 12px; }
  .mimo-home-art { height: 340px; border-radius: 16px; }
  .mimo-art-word { font-size: 34vw; }
  .mimo-art-caption { left: 16px; bottom: 18px; gap: 10px; font-size: 8px; }
  .mimo-art-index { right: 16px; bottom: 16px; font-size: 13px; }
  .hub-section-head { margin-top: 46px; }
}
@media (prefers-reduced-motion: reduce) {
  .mimo-home-art::before, .mimo-scroll-cue span:last-child { animation: none; }
  .mimo-reveal { opacity: 1; transform: none; transition: none; }
  .mimo-home-button, .mimo-art-word { transition: none; }
}
}
