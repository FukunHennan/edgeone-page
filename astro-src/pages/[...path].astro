---
import { render, getCollection, type CollectionEntry } from 'astro:content';
import Shell from '../layouts/Shell.astro';
import ScenicBanner from '../components/ScenicBanner.astro';
import { languages, postsFor, projectsFor, postPath, archiveFilterPath, type TaxonomyKind, type Post, type Language } from '../lib/content';
export async function getStaticPaths() {
  const posts = (await Promise.all(languages.map(postsFor))).flat();
  const projectPaths = new Set<string>();
  for (const lang of languages) for (const project of await projectsFor(lang)) {
    projectPaths.add(`/${lang}/${project.data.post.replace(/^\.\.\//, '')}`);
  }
  const urls = new Set<string>();
  const articles = posts.map((post) => {
    const url = postPath(post); if (urls.has(url)) throw new Error(`Duplicate article URL: ${url}`); urls.add(url);
    const translation = posts.find((item) => item.data.lang !== post.data.lang && item.data.translation_key === post.data.translation_key);
    if (!translation) throw new Error(`Missing translation: ${post.id}`);
    return { params: { path: url.replace(/^\/|\/$/g, '') }, props: { post, lang: post.data.lang, alternate: postPath(translation), projectDetail: projectPaths.has(url) } };
  });
  const pages = [];
  for (const lang of languages) for (const post of await getCollection(lang === 'zh-CN' ? 'pagesZh' : 'pagesEn')) {
    if (post.id === 'projects') continue;
    pages.push({ params: { path: `${lang}/${post.id}` }, props: { post, lang, alternate: `/${lang === 'zh-CN' ? 'en' : 'zh-CN'}/${post.id}/` } });
  }
  return [...articles, ...pages];
}
interface Props { post: Post | CollectionEntry<'pagesZh'> | CollectionEntry<'pagesEn'>; lang: Language; alternate: string; projectDetail?: boolean }
const { post, lang, alternate, projectDetail = false } = Astro.props;
const { Content, headings } = await render(post);
const day = (value?: Date) => value?.toISOString().slice(0, 10);
const termLink = (section: TaxonomyKind, name: string) => archiveFilterPath(lang, section, name);
const tocHeadings = headings.filter((heading) => heading.depth <= 3);
---
<Shell lang={lang} title={post.data.title} description={'description' in post.data ? post.data.description : ''} alternate={alternate} published={'date' in post.data ? post.data.date : undefined} updated={'updated' in post.data ? post.data.updated : undefined} activeSection={projectDetail ? 'projects' : undefined} noindex={!projectDetail && ('date' in post.data || post.id === 'notes' || post.id.startsWith('notes/'))}>
  {'date' in post.data ? <><div class="scenic-article-banner"><ScenicBanner compact scene="forest" /></div><article class="astro-article">
    <header class="astro-article-head">
      {projectDetail && <a class="scenic-project-back" href={`/${lang}/projects/`}>{lang === 'zh-CN' ? '← 返回项目' : '← Back to projects'}</a>}
      <p class="astro-article-date"><time datetime={post.data.date.toISOString()}>{day(post.data.date)}</time></p>
      <h1>{post.data.title}</h1>
      {post.data.description && <p class="astro-lede">{post.data.description}</p>}
    </header>
    <aside class="astro-article-rail">
      {tocHeadings.length > 0 && <nav class="astro-toc astro-toc-desktop" aria-label={lang === 'zh-CN' ? '文章目录' : 'Contents'}>
        <p class="astro-rail-title">{lang === 'zh-CN' ? '文章目录' : 'Contents'}</p>
        <ul>{tocHeadings.map((heading) => <li class={`depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul>
      </nav>}
      <div class="astro-article-meta">
        <p class="astro-rail-title">{lang === 'zh-CN' ? '文章信息' : 'Details'}</p>
        <dl>
          <div><dt>{lang === 'zh-CN' ? '发布' : 'Published'}</dt><dd><time datetime={post.data.date.toISOString()}>{day(post.data.date)}</time></dd></div>
          {post.data.updated && <div><dt>{lang === 'zh-CN' ? '更新' : 'Updated'}</dt><dd><time datetime={post.data.updated.toISOString()}>{day(post.data.updated)}</time></dd></div>}
          {!projectDetail && post.data.categories.length > 0 && <div><dt>{lang === 'zh-CN' ? '分类' : 'Categories'}</dt><dd class="astro-terms">{post.data.categories.map((name) => <a href={termLink('categories', name)}>{name}</a>)}</dd></div>}
          {!projectDetail && post.data.tags.length > 0 && <div><dt>{lang === 'zh-CN' ? '标签' : 'Tags'}</dt><dd class="astro-terms">{post.data.tags.map((name) => <a href={termLink('tags', name)}>{name}</a>)}</dd></div>}
        </dl>
      </div>
    </aside>
    {tocHeadings.length > 0 && <details class="astro-toc-mobile">
      <summary>{lang === 'zh-CN' ? '文章目录' : 'Contents'}</summary>
      <nav class="astro-toc" aria-label={lang === 'zh-CN' ? '文章目录' : 'Contents'}>
        <ul>{tocHeadings.map((heading) => <li class={`depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul>
      </nav>
    </details>}
    <div class="astro-article-body"><div class="astro-prose"><Content /></div></div>
  </article></> : post.id === 'about' ?
    <div class="scenic-interior-wrap">
      <ScenicBanner scene="coast" label="ABOUT · THE MAKER" title={lang === 'zh-CN' ? '关于我' : 'About me'} subtitle={lang === 'zh-CN' ? '一个喜欢折腾的开发者，记录学习与创造。' : 'Learning, making, and enjoying the journey.'} />
      <section class="scenic-about-card">
        <div class="scenic-about-profile">
          <img src="/theme/images/稻田鼠.jpg" alt={lang === 'zh-CN' ? '稻田鼠个人头像' : 'Personal site avatar'} width="124" height="124" loading="lazy" />
          <div><strong>{lang === 'zh-CN' ? '稻田鼠' : 'Datianshu'}</strong><p>BUILD · LEARN · CREATE</p></div>
        </div>
        <div class="scenic-about-prose astro-prose"><Content /></div>
        <aside class="scenic-about-skills">
          <h2>{lang === 'zh-CN' ? '探索方向' : 'Areas of interest'}</h2>
          <div><span>Embedded & ESP32</span><span>Linux</span><span>KiCad & PCB</span><span>Astro & Web</span><span>Robotics</span></div>
        </aside>
      </section>
    </div> : post.id === 'experience' ?
    <div class="scenic-interior-wrap">
      <ScenicBanner scene="meadow" label="JOURNEY · LEARNING · MAKING" title={lang === 'zh-CN' ? '我的经历' : 'My journey'} subtitle={lang === 'zh-CN' ? '沿着技术、创造与实践，记录成长。' : 'A personal path through learning and making.'} />
      <Content />
    </div> : post.id === 'resume' ?
    <div class="scenic-interior-wrap scenic-resume-wrap">
      <div class="scenic-resume-backdrop" aria-hidden="true"><img src="/scenes/gallery-forest.webp" alt="" width="1280" height="720" loading="eager" /></div>
      <Content />
    </div> : post.id.startsWith('notes/') ?
    <div class="scenic-interior-wrap scenic-note-wrap">
      <ScenicBanner compact scene="forest" />
      <article class="scenic-note">
        <a class="scenic-note-back" href={`/${lang}/notes/`}>{lang === 'zh-CN' ? '← 返回知识库' : '← Back to notes'}</a>
        <div class="astro-prose"><Content /></div>
      </article>
    </div> : <Content />}
</Shell>
