---
import { render, getCollection, type CollectionEntry } from 'astro:content';
import Shell from '../layouts/Shell.astro';
import { languages, postsFor, postPath, type Post, type Language } from '../lib/content';
import { registryMarkup } from '../lib/theme';
import toolsZh from '../../data/zh-CN/tools.yml?raw';
import toolsEn from '../../data/en/tools.yml?raw';
import yaml from 'js-yaml';
export async function getStaticPaths() {
  const posts = (await Promise.all(languages.map(postsFor))).flat();
  const urls = new Set<string>();
  const articles = posts.map((post) => {
    const url = postPath(post); if (urls.has(url)) throw new Error(`Duplicate article URL: ${url}`); urls.add(url);
    const translation = posts.find((item) => item.data.lang !== post.data.lang && item.data.translation_key === post.data.translation_key);
    if (!translation) throw new Error(`Missing translation: ${post.id}`);
    return { params: { path: url.replace(/^\/|\/$/g, '') }, props: { post, lang: post.data.lang, alternate: postPath(translation) } };
  });
  const pages = [];
  for (const lang of languages) for (const post of await getCollection(lang === 'zh-CN' ? 'pagesZh' : 'pagesEn')) {
    if (post.id === 'projects') continue;
    pages.push({ params: { path: `${lang}/${post.id}` }, props: { post, lang, alternate: `/${lang === 'zh-CN' ? 'en' : 'zh-CN'}/${post.id}/` } });
  }
  return [...articles, ...pages];
}
interface Props { post: Post | CollectionEntry<'pagesZh'> | CollectionEntry<'pagesEn'>; lang: Language; alternate: string }
const { post, lang, alternate } = Astro.props;
const { Content, headings } = await render(post);
const tools = 'registry' in post.data && post.data.registry === 'tools' ? yaml.load(lang === 'zh-CN' ? toolsZh : toolsEn) as unknown[] : null;
---
<Shell lang={lang} title={post.data.title} description={'description' in post.data ? post.data.description : ''} alternate={alternate}>
  {tools ? <Fragment set:html={registryMarkup('tools', lang, tools)} /> : 'date' in post.data ? <article class="astro-article">
    <header><p><time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10)}</time></p><h1>{post.data.title}</h1><p>{post.data.description}</p></header>
    {headings.length > 0 && <details class="astro-toc"><summary>{lang === 'zh-CN' ? '文章目录' : 'Contents'}</summary><ul>{headings.filter((heading) => heading.depth <= 3).map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></details>}
    <div class="astro-prose"><Content /></div>
  </article> : <Content />}
</Shell>
