---
import { render, getCollection, type CollectionEntry } from 'astro:content';
import Shell from '../layouts/Shell.astro';
import ScenicBanner from '../components/ScenicBanner.astro';
import { languages, type Language } from '../lib/content';
// 博客文章（/{lang}/posts/…）已改为 astro-src/pages/{lang}/posts/ 下的独立 HTML 文件，
// 不再由本路由渲染；这里只负责 source/{lang}/ 下的静态页面。
export async function getStaticPaths() {
  const pages = [];
  for (const lang of languages) for (const post of await getCollection('pagesZh')) {
    if (post.id === 'projects') continue;
    pages.push({ params: { path: `${lang}/${post.id}` }, props: { post, lang } });
  }
  return pages;
}
interface Props { post: CollectionEntry<'pagesZh'>; lang: Language }
const { post, lang } = Astro.props;
const { Content } = await render(post);
---
<Shell lang={lang} title={post.data.title} noindex={post.id === 'notes' || post.id.startsWith('notes/')}>
  {post.id === 'about' ?
    <div class="scenic-interior-wrap">
      <ScenicBanner scene="coast" label="ABOUT · THE MAKER" title={lang === 'zh-CN' ? '关于我' : 'About me'} subtitle={lang === 'zh-CN' ? '一个喜欢折腾的开发者，记录学习与创造。' : 'Learning, making, and enjoying the journey.'} />
      <section class="scenic-about-card">
        <div class="scenic-about-profile">
          <img src="/theme/images/稻田鼠.jpg" alt={lang === 'zh-CN' ? '稻田鼠个人头像' : 'Personal site avatar'} width="124" height="124" loading="lazy" />
          <div><strong>{lang === 'zh-CN' ? '稻田鼠' : 'Datianshu'}</strong><p>BUILD · LEARN · CREATE</p></div>
        </div>
        <div class="scenic-about-prose astro-prose"><Content /></div>
        <aside class="scenic-about-skills">
          <h2>{lang === 'zh-CN' ? '探索方向' : 'Areas of interest'}</h2>
          <div><span>Embedded & ESP32</span><span>Linux</span><span>KiCad & PCB</span><span>Astro & Web</span><span>Robotics</span></div>
        </aside>
      </section>
    </div> : post.id === 'experience' ?
    <div class="scenic-interior-wrap">
      <ScenicBanner scene="meadow" label="JOURNEY · LEARNING · MAKING" title={lang === 'zh-CN' ? '我的经历' : 'My journey'} subtitle={lang === 'zh-CN' ? '沿着技术、创造与实践，记录成长。' : 'A personal path through learning and making.'} />
      <Content />
    </div> : post.id === 'resume' ?
    <div class="scenic-interior-wrap scenic-resume-wrap">
      <div class="scenic-resume-backdrop" aria-hidden="true"><img src="/scenes/gallery-forest.webp" alt="" width="1280" height="720" loading="eager" /></div>
      <Content />
    </div> : post.id.startsWith('notes/') ?
    <div class="scenic-interior-wrap scenic-note-wrap">
      <ScenicBanner compact scene="forest" />
      <article class="scenic-note">
        <a class="scenic-note-back" href={`/${lang}/notes/`}>{lang === 'zh-CN' ? '← 返回知识库' : '← Back to notes'}</a>
        <div class="astro-prose"><Content /></div>
      </article>
    </div> : <Content />}
</Shell>
