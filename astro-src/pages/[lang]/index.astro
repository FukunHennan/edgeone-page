---
import Shell from '../../layouts/Shell.astro';
import { languages, postsFor, type Language } from '../../lib/content';
import { themePartial } from '../../lib/theme';
export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Language;
const posts = await postsFor(lang);
---
<Shell lang={lang} title={lang === 'zh-CN' ? '首页' : 'Home'}><Fragment slot="hero" set:html={themePartial('hero', lang, Astro.url.pathname)} /><Fragment set:html={themePartial('dashboard', lang, Astro.url.pathname, posts)} /></Shell>
