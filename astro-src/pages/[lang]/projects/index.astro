---
import Shell from '../../../layouts/Shell.astro';
import { languages, projectsFor, type Language } from '../../../lib/content';
import { registryMarkup } from '../../../lib/theme';
export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Language;
const projects = await projectsFor(lang);
---
<Shell lang={lang} title={lang === 'zh-CN' ? '项目' : 'Projects'}><Fragment set:html={registryMarkup(lang, projects.map((project) => project.data))} /></Shell>
