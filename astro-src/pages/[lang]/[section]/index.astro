---
import Shell from '../../../layouts/Shell.astro';
import { languages, taxonomyFor, type Language, type TaxonomyKind } from '../../../lib/content';
export function getStaticPaths() {
  return languages.flatMap((lang) => (['categories', 'tags'] as const).map((section) => ({ params: { lang, section } })));
}
const lang = Astro.params.lang as Language;
const section = Astro.params.section as TaxonomyKind;
const terms = await taxonomyFor(lang, section);
const title = section === 'categories' ? (lang === 'zh-CN' ? '分类' : 'Categories') : (lang === 'zh-CN' ? '标签' : 'Tags');
---
<Shell lang={lang} title={title}>
  <section class="astro-collection">
    <a class="astro-collection-back" href={`/${lang}/archives/`}>{lang === 'zh-CN' ? '文章归档' : 'Writing'}</a>
    <h1>{title}</h1>
    <div class="astro-term-list">{terms.map((term) => <a href={`/${lang}/${section}/${term.slug}/`}><span>{term.name}</span><small>{term.posts.length}</small></a>)}</div>
  </section>
</Shell>
