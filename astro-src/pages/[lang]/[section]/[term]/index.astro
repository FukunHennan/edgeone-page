---
import Shell from '../../../../layouts/Shell.astro';
import ArticleList from '../../../../components/ArticleList.astro';
import { languages, taxonomyFor, type Language, type TaxonomyKind, type Post } from '../../../../lib/content';
export async function getStaticPaths() {
  const paths = [];
  for (const lang of languages) for (const section of ['categories', 'tags'] as const) {
    for (const term of await taxonomyFor(lang, section)) {
      paths.push({ params: { lang, section, term: term.slug }, props: { name: term.name, posts: term.posts } });
    }
  }
  return paths;
}
interface Props { name: string; posts: Post[] }
const { name, posts } = Astro.props;
const lang = Astro.params.lang as Language;
const section = Astro.params.section as TaxonomyKind;
const label = section === 'categories' ? '分类' : '标签';
---
<Shell lang={lang} title={`${label} · ${name}`} noindex>
  <section class="astro-collection">
    <a class="astro-collection-back" href={`/${lang}/${section}/`}>{label}</a>
    <h1>{name}</h1>
    <p>{posts.length} 篇文章</p>
    <ArticleList posts={posts} lang={lang} />
  </section>
</Shell>
