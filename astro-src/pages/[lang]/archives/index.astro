---
import Shell from '../../../layouts/Shell.astro';
import ArticleList from '../../../components/ArticleList.astro';
import { languages, postsFor, type Language } from '../../../lib/content';
export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Language;
const posts = await postsFor(lang);
---
<Shell lang={lang} title={lang === 'zh-CN' ? '文章' : 'Writing'}>
  <section class="workspace-hero"><h1>{lang === 'zh-CN' ? '工程与学习记录' : 'Engineering and learning'}</h1></section>
  <nav class="astro-browse" aria-label={lang === 'zh-CN' ? '浏览文章' : 'Browse writing'}>
    <a href={`/${lang}/categories/`}>{lang === 'zh-CN' ? '按分类' : 'Categories'}</a>
    <a href={`/${lang}/tags/`}>{lang === 'zh-CN' ? '按标签' : 'Tags'}</a>
  </nav>
  <ArticleList posts={posts} lang={lang} />
</Shell>
