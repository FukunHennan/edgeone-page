---
import { postPath, termSlug, type Post, type Language } from '../lib/content';
interface Props { posts: Post[]; lang: Language }
const { posts, lang } = Astro.props;
---
<div class="astro-writing">
  {posts.map((post) => <article class="scenic-story" data-article-search={`${post.data.title} ${post.data.description || ''} ${post.data.categories.join(' ')} ${post.data.tags.join(' ')}`.toLocaleLowerCase()}>
    <a class="scenic-story-image" href={postPath(post)} aria-label={post.data.title}>
      {post.data.cover
        ? <img class="cover-image" src={post.data.cover} alt="" loading="lazy" decoding="async" width="520" height="293" />
        : <>
          <img class="cover-image cover-light" src="/covers/article-light.webp" alt={lang === 'zh-CN' ? '文章封面待插入' : 'Article cover coming soon'} loading="lazy" decoding="async" width="520" height="293" />
          <img class="cover-image cover-dark" src="/covers/article-dark.webp" alt="" aria-hidden="true" loading="lazy" decoding="async" width="520" height="293" />
        </>}
    </a>
    <div class="scenic-story-copy">
      <time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10)}</time>
      <h2><a href={postPath(post)}>{post.data.title}</a></h2>
      {post.data.description && <p>{post.data.description}</p>}
      <div class="astro-article-terms">
        {post.data.categories.map((name) => <a href={`/${lang}/categories/${termSlug(name)}/`}>{name}</a>)}
        {post.data.tags.map((name) => <a href={`/${lang}/tags/${termSlug(name)}/`}>#{name}</a>)}
      </div>
    </div>
  </article>)}
</div>
