---
import type { Language } from '../lib/content';
interface Props { lang: Language }
const { lang } = Astro.props;
const zh = lang === 'zh-CN';
---
<section class="agent-chat" data-agent-chat data-lang={lang} aria-label={zh ? 'AI 对话' : 'AI chat'}>
  <div class="agent-chat-top">
    <span class="agent-chat-status"><span class="agent-status-dot" aria-hidden="true"></span>{zh ? '网站知识助手' : 'Site knowledge assistant'}</span>
    <button type="button" class="agent-new-chat" data-new-chat>{zh ? '新对话' : 'New chat'}</button>
  </div>
  <div class="agent-message-list" data-messages role="log" aria-live="polite" aria-relevant="additions text">
    <div class="agent-message agent-message-assistant">
      {zh ? '你好！你可以问我关于稻田鼠的公开博客、项目和技术记录。' : 'Hello! Ask me about Daotianshu’s public posts, projects, and engineering notes.'}
    </div>
  </div>
  <div class="agent-suggestions" data-suggestions>
    <button type="button" data-suggest={zh ? '你有哪些项目？' : 'What projects are on this site?'}>{zh ? '你有哪些项目？' : 'Explore projects'}</button>
    <button type="button" data-suggest={zh ? '帮我找 ESP32 相关的文章' : 'Find articles about ESP32'}>{zh ? 'ESP32 相关文章' : 'ESP32 articles'}</button>
    <button type="button" data-suggest={zh ? '介绍一下这个网站' : 'Introduce this website'}>{zh ? '介绍一下网站' : 'About this site'}</button>
  </div>
  <form class="agent-input-form" data-agent-form>
    <label class="agent-input-label" for="agent-input">{zh ? '发送消息' : 'Send a message'}</label>
    <textarea id="agent-input" data-agent-input rows="2" maxlength="2000" required placeholder={zh ? '输入问题，Enter 发送，Shift+Enter 换行…' : 'Type a question. Enter to send, Shift+Enter for newline…'}></textarea>
    <div class="agent-input-actions">
      <span data-agent-status role="status" aria-live="polite">{zh ? '只检索公开内容' : 'Public content only'}</span>
      <button type="button" data-agent-stop hidden>{zh ? '停止' : 'Stop'}</button>
      <button type="submit" data-agent-send>{zh ? '发送 ↗' : 'Send ↗'}</button>
    </div>
  </form>
</section>
<style>
.agent-chat{background:rgba(255,255,255,.94);border:1px solid #dee8e4;border-radius:22px;box-shadow:0 18px 56px rgba(24,54,50,.06);overflow:hidden}
.agent-chat-top{min-height:65px;padding:15px 23px;border-bottom:1px solid #e6ecea;display:flex;justify-content:space-between;gap:15px;align-items:center}
.agent-chat-status{display:inline-flex;align-items:center;gap:9px;font-weight:720;font-size:13px;color:#365b55}
.agent-status-dot{height:8px;width:8px;background:#5eac85;border-radius:50%}
.agent-new-chat{border:1px solid #d9e5e0;background:#f7faf8;border-radius:99px;padding:8px 14px;cursor:pointer;font-size:12px;color:#395f59}
.agent-message-list{min-height:270px;max-height:min(58vh,540px);overflow-y:auto;padding:26px;display:flex;flex-direction:column;gap:20px;scrollbar-color:#bfd0cb transparent}
.agent-message{white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.85;font-size:14px;max-width:min(90%,700px);border-radius:16px;padding:13px 17px}
.agent-message-assistant{align-self:flex-start;background:#f2f6f4;border:1px solid #e7eeeb;color:#344542}
.agent-message-user{align-self:flex-end;background:#27594f;color:white}
.agent-message a{color:#17675f;text-decoration:underline}
.agent-message-user a{color:white}
.agent-suggestions{padding:0 25px 18px;display:flex;gap:8px;flex-wrap:wrap}
.agent-suggestions button{padding:8px 12px;border:1px solid #d9e6e1;background:#f9fbfa;border-radius:20px;color:#4c6962;font-size:12px;cursor:pointer}
.agent-input-form{padding:16px 22px 19px;border-top:1px solid #e6ecea}
.agent-input-label{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
.agent-input-form textarea{box-sizing:border-box;display:block;width:100%;resize:vertical;min-height:70px;max-height:180px;padding:12px;background:#f9fbfa;border:1px solid #dae5e0;border-radius:12px;color:#243c36;line-height:1.5;font-size:14px;outline-offset:2px}
.agent-input-form textarea:focus{outline:2px solid #3b8d79;border-color:transparent}
.agent-input-actions{display:flex;align-items:center;justify-content:flex-end;gap:10px;margin-top:10px}
.agent-input-actions span{margin-right:auto;font-size:11px;color:#71817a}
.agent-input-actions button{border:0;background:#295e53;color:white;border-radius:11px;padding:10px 17px;font-size:13px;font-weight:650;cursor:pointer}
.agent-input-actions [data-agent-stop]{background:#e9eeee;color:#405851}
.agent-input-actions button:disabled{opacity:.5;cursor:not-allowed}
@media(max-width:600px){.agent-chat-top{padding:13px 15px}.agent-message-list{padding:16px;max-height:56vh}.agent-message{max-width:96%}.agent-suggestions{padding:0 15px 15px}.agent-input-form{padding:13px 15px}}
</style>
