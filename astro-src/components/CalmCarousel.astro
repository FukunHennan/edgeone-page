---
import '../styles/calm-home.css';
import type { Language } from '../lib/content';
interface Props { lang: Language }
const { lang } = Astro.props;
const zh = lang === 'zh-CN';
// The homepage is deliberately a PHOTO slideshow: no <video>, MP4, or autoplaying footage.
// These are the four self-hosted nature photographs available in the repository.
// Each one ships three widths (960 / 1440 / 1920) so phones never download the 1920 file.
const scenes = [
  {
    name: 'gallery-mountain',
    alt: zh ? '清晨的群山与湖泊' : 'Mountain lake in the morning',
    caption: zh ? '山间清晨' : 'Morning by the lake',
  },
  {
    name: 'gallery-coast',
    alt: zh ? '宁静海岸与海浪' : 'Peaceful coastline',
    caption: zh ? '宁静海岸' : 'Along the coast',
  },
  {
    name: 'gallery-meadow',
    alt: zh ? '微风中的青绿草甸' : 'Meadow in a gentle breeze',
    caption: zh ? '风吹草甸' : 'Green meadow',
  },
  {
    name: 'gallery-forest',
    alt: zh ? '林间溪流与柔和晨光' : 'Forest stream in morning light',
    caption: zh ? '林间微光' : 'Forest stream',
  },
];
// 横屏窄机（如 iPhone SE 横屏）也需要覆盖，故最小档从 640 宽算起。
// 1920 档直接复用 /scenes 下的原图，其余档位在 /scenes/responsive 中生成。
const sizes = '100vw';
const slides = scenes.map((scene) => ({
  ...scene,
  src: `/scenes/${scene.name}.webp`,
  srcset: [640, 960, 1440, 1920]
    .map((width) => (width === 1920
      ? `/scenes/${scene.name}.webp ${width}w`
      : `/scenes/responsive/${scene.name}-${width}.webp ${width}w`))
    .join(', '),
}));
---
<section class="calm-home" data-calm-carousel aria-roledescription={zh ? '风景照片轮播' : 'Scenic photo slideshow'} aria-label={zh ? '四季风景，慢慢欣赏' : 'Relaxing landscape photography'}>
  <div class="calm-slides" aria-live="off">
    {slides.map((slide, index) => (
      <figure class:list={['calm-slide', { 'is-active': index === 0 }]} data-calm-slide aria-hidden={index !== 0}>
        <img class="calm-poster" src={slide.src} srcset={slide.srcset} sizes={sizes}
          alt={slide.alt} width="1920" height="1080"
          loading={index === 0 ? 'eager' : 'lazy'} decoding="async"
          fetchpriority={index === 0 ? 'high' : 'auto'}/>
      </figure>
    ))}
  </div>
  <div class="calm-overlay" aria-hidden="true"></div>
  <div class="calm-content">
    <p class="calm-eyebrow">{zh ? '稻田鼠 · 一处安静的角落' : 'A QUIET CORNER OF THE WEB'}</p>
    <h1>{zh ? '慢一点，' : 'Take a moment,'}<span>{zh ? '也很好。' : ' stay a while.'}</span></h1>
    <p class="calm-description">{zh ? '在自然的节奏里，找到更平静的自己。' : 'Find a quieter moment in the rhythm of nature.'}</p>
  </div>
  <div class="calm-accessibility-actions">
    <button type="button" data-calm-pause aria-label={zh ? '暂停照片轮播' : 'Pause photo slideshow'} aria-pressed="false">{zh ? '暂停轮播' : 'Pause slideshow'}</button>
    <button type="button" data-calm-immersive aria-label={zh ? '进入沉浸模式' : 'Enter immersive mode'} aria-pressed="false">{zh ? '沉浸模式' : 'Immersive view'}</button>
  </div>
  <p class="calm-sr-only" aria-live="polite" aria-atomic="true" data-calm-announcement></p>
</section>
