---
import '../styles/calm-home.css';
import type { Language } from '../lib/content';
interface Props { lang: Language }
const { lang } = Astro.props;
const zh = lang === 'zh-CN';
const slides = [
  {
    video: '/scenes/mountain-lake.mp4',
    poster: '/scenes/mountain-lake.webp',
    fallback: '/scenes/mountain-lake.svg',
    alt: zh ? '日本三方五湖与远山的自然实景' : 'Real view of the Mikata Five Lakes',
    caption: zh ? '山间清晨' : 'Morning by the lake', english: 'MOUNTAIN LAKE',
  },
  {
    video: '/scenes/soft-coast.mp4',
    poster: '/scenes/soft-coast.webp',
    fallback: '/scenes/soft-coast.svg',
    alt: zh ? '挪威索玛罗伊的宁静海景' : 'Quiet Norwegian seascape',
    caption: zh ? '宁静海岸' : 'Along the coast', english: 'SOFT COAST',
  },
  {
    video: '/scenes/green-meadow.mp4',
    poster: '/scenes/green-meadow.webp',
    fallback: '/scenes/green-meadow.svg',
    alt: zh ? '微风吹动溪边草地的实景' : 'Grass moving beside a stream',
    caption: zh ? '风吹草甸' : 'The open meadow', english: 'GREEN MEADOW',
  },
  {
    video: '/scenes/misty-forest.mp4',
    poster: '/scenes/misty-forest.webp',
    fallback: '/scenes/misty-forest.svg',
    alt: zh ? '不列颠哥伦比亚林间溪流的实景' : 'Quiet forest creek in British Columbia',
    caption: zh ? '林间微光' : 'A gentle forest', english: 'FOREST STREAM',
  },
];
---
<section class="calm-home" data-calm-carousel aria-roledescription={zh ? '风景轮播' : 'Scenic carousel'} aria-label={zh ? '放慢脚步，看看风景' : 'A moment to slow down'}>
  <div class="calm-slides" aria-live="off">
    {slides.map((slide, index) => (
      <figure class:list={['calm-slide', { 'is-active': index === 0 }]} data-calm-slide aria-hidden={index !== 0}>
        <img class="calm-poster" src={slide.poster} data-fallback-src={slide.fallback} alt={slide.alt} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" fetchpriority={index === 0 ? 'high' : 'auto'} width="1600" height="900" style={`background-image: url('${slide.fallback}')`} />
        <video class="calm-video" data-calm-video data-video-src={slide.video} poster={slide.poster} muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"></video>
        <figcaption class="calm-caption"><span>{String(index + 1).padStart(2, '0')} / 04</span><span>{slide.caption}</span><small>{slide.english}</small></figcaption>
      </figure>
    ))}
  </div>
  <div class="calm-overlay" aria-hidden="true"></div>
  <div class="calm-content">
    <p class="calm-eyebrow">{zh ? '稻田鼠 · 一处安静的角落' : 'A QUIET CORNER OF THE WEB'}</p>
    <h1>{zh ? '慢一点，' : 'Take a moment,'}<span>{zh ? '也很好。' : 'stay a while.'}</span></h1>
    <p class="calm-description">{zh ? '看看山川和光影。生活不只有忙碌，也有值得停留的风景。' : 'For the mountains, the light, and the little things worth noticing.'}</p>
  </div>
  {/* Pause and immersive controls remain keyboard/screen-reader accessible but do not occupy the image. */}
  <div class="calm-accessibility-actions">
    <button type="button" data-calm-pause aria-label={zh ? '暂停自动轮播' : 'Pause automatic slideshow'} aria-pressed="false">{zh ? '暂停风景动画' : 'Pause scenery'}</button>
    <button type="button" data-calm-immersive aria-label={zh ? '进入沉浸模式' : 'Enter immersive mode'} aria-pressed="false">{zh ? '沉浸模式' : 'Immersive view'}</button>
  </div>
  <p class="sr-only" aria-live="polite" aria-atomic="true" data-calm-announcement></p>
</section>