---
import '../styles/site.css';
import '../styles/interior-pages.css';
import { themePartial } from '../lib/theme';
import type { Language } from '../lib/content';
interface Props { lang: Language; title: string; description?: string; alternate?: string; published?: Date; updated?: Date }
const { lang, title, description = '', alternate, published, updated } = Astro.props;
const home = Astro.url.pathname === `/${lang}/`;
const scenicInterior = !home && !Astro.url.pathname.startsWith(`/${lang}/resume/`);
const other = lang === 'zh-CN' ? 'en' : 'zh-CN';
const otherPath = alternate || Astro.url.pathname.replace(`/${lang}/`, `/${other}/`);
const canonical = new URL(Astro.url.pathname, Astro.site);
// --- OG / Twitter 分享卡片（P0 修复）---
const ogImage = new URL('/scenes/gallery-mountain.webp', Astro.site).href;
const siteName = lang === 'zh-CN' ? '稻田鼠' : 'Daotianshu';
const ogLocale = lang === 'zh-CN' ? 'zh_CN' : 'en_US';
const ogLocaleAlt = lang === 'zh-CN' ? 'en_US' : 'zh_CN';
const shareTitle = description ? `${title} · ${siteName}` : siteName;
const modified = updated || published;
const isArticle = Astro.url.pathname.includes('/posts/');
const schema = {
  '@context': 'https://schema.org',
  '@type': isArticle ? 'BlogPosting' : 'WebPage',
  headline: title,
  name: title,
  description,
  url: canonical.href,
  inLanguage: lang,
  ...(isArticle ? { author: { '@type': 'Person', name: '陈富坤' }, datePublished: published?.toISOString(), dateModified: (updated || published)?.toISOString() } : {}),
};
const fonts = lang === 'zh-CN' ? '"PingFang SC","Microsoft YaHei","Noto Sans CJK SC","Source Han Sans SC",system-ui,sans-serif' : '"Geist Variable","Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif';
---
<!doctype html>
<html lang={lang} class="light">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · 稻田鼠</title><meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonical} /><link rel="alternate" hreflang={lang} href={canonical} /><link rel="alternate" hreflang={other} href={new URL(otherPath, Astro.site)} /><link rel="alternate" hreflang="x-default" href={new URL(`/zh-CN/`, Astro.site)} />
    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="1080" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    {isArticle && published && <meta property="article:published_time" content={published.toISOString()} />}
    {isArticle && modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="alternate" type="application/rss+xml" title="RSS" href={`/${lang}/feed.xml`} />
    <link rel="manifest" href={`/${lang}/manifest.webmanifest`} /><link rel="icon" href="/icons/稻田鼠.jpg" type="image/jpeg" />
    <script type="application/ld+json" data-edgeone-schema set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    <script is:inline data-edgeone-service-worker>
      if ('serviceWorker' in navigator && (location.protocol === 'https:' || location.hostname === 'localhost')) {
        window.addEventListener('load', () => navigator.serviceWorker.register('/service-worker.js', { scope: '/', updateViaCache: 'none' }).catch(console.error), { once: true });
      }
    </script>
    <link rel="stylesheet" href="/theme/tailwind.css" /><link rel="stylesheet" href="/theme/fontawesome/subset.min.css" /><link rel="stylesheet" href="/theme/style.css" />
    <style is:inline define:vars={{ fonts }}>body,input,button,select,textarea{font-family:var(--fonts)}code,pre{font-family:"Geist Mono","SFMono-Regular",Consolas,monospace}</style>
    <style is:inline>
      /* 站点只提供亮色主题。尽早声明 color-scheme，避免浏览器按系统偏好绘制深色滚动条与表单控件。 */
      :root { color-scheme: light only; }
    </style>
  </head>
  <body>
    <a class="astro-skip" href="#main">{lang === 'zh-CN' ? '跳至内容' : 'Skip to content'}</a>
    <div id="swup" class:list={['page-container', { 'home-mimo-page': home, 'scenic-inner': scenicInterior }]}>
      <Fragment set:html={themePartial('navbar', lang, Astro.url.pathname, [], otherPath)} />
      <slot name="hero" />
      <div class="main-content-container flex flex-col justify-between min-h-dvh"><main id="main" class="main-content-body transition-fade-up"><div class="main-content"><slot /></div></main></div>
      {!home && <a class="page-back" href={`/${lang}/`} data-no-swup data-history-back>
        <span class="page-back-icon" aria-hidden="true">←</span><span data-history-back-label>{lang === 'zh-CN' ? '返回上一页' : 'Go back'}</span>
      </a>}
      <dialog id="astro-search"><form method="dialog"><button aria-label={lang === 'zh-CN' ? '关闭' : 'Close'}>×</button></form><label for="astro-search-input">{lang === 'zh-CN' ? '搜索文章' : 'Search articles'}</label><input id="astro-search-input" type="search" /><ul id="astro-search-results"></ul></dialog>
    </div>
    {['Swup','SwupSlideTheme','SwupProgressPlugin','SwupScrollPlugin','SwupPreloadPlugin'].map((name) => <script is:inline src={`/theme/js/${name}.min.js`}></script>)}
    <script>import '../scripts/theme-runtime';</script>
  </body>
</html>
